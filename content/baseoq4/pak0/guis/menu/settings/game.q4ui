    "condition": {"op": "==", "args": [{"state": "game.section"}, 0]},
    "then": [{"op": "focus", "control": "game_freelook"}],
    "else": [
     {
      "op": "if",
      "condition": {"op": "==", "args": [{"state": "game.section"}, 1]},
      "then": [{"op": "focus", "control": "game_invertmouse"}],
      "else": [
       {
        "op": "if",
        "condition": {"op": "==", "args": [{"state": "game.section"}, 2]},
        "then": [{"op": "focus", "control": "game_controller"}],
        "else": [
         {
          "op": "if",
          "condition": {"op": "==", "args": [{"state": "game.section"}, 3]},
          "then": [{"op": "focus", "control": "game_customcrosshair"}],
          "else": [
           {
            "op": "if",
            "condition": {"op": "==", "args": [{"state": "game.section"}, 4]},
            "then": [{"op": "focus", "control": "game_hudlayout"}],
            "else": [
             {
              "op": "if",
              "condition": {"op": "==", "args": [{"state": "game.section"}, 5]},
              "then": [{"op": "focus", "control": "game_corpsesink"}],
              "else": [
               {
                "op": "if",
                "condition": {"op": "==", "args": [{"state": "game.section"}, 6]},
                "then": [{"op": "focus", "control": "game_gunfov"}],
                "else": [{"op": "focus", "control": "game_vr"}]
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   }
  ],
  "onActivate": [
   {
    "op": "if",
    "condition": {"state": "game.languageReloaded"},
    "then": [{"op": "focus", "control": "game_language"}],
    "else": [{"op": "focus", "control": "game_section"}]
   }
  ],
  "onBack": [{"op": "action", "action": "back"}]
 },
 "bindings": [
  {
   "id": "game_crosshair-preview.image",
   "node": "game_crosshair-preview",
   "property": "image",
   "value": {"state": "game.crosshairImage"}
  },
  {
   "id": "game_crosshair.enabled",
   "node": "game_crosshair",
   "property": "enabled",
   "value": {"op": "==", "args": [{"state": "cvar.g_crosshairCustom"}, "1"]}
  },
  {
   "id": "game_crosshair_number.enabled",
   "node": "game_crosshair_number",
   "property": "enabled",
   "value": {"op": "==", "args": [{"state": "cvar.g_crosshairCustom"}, "1"]}
  }
 ],
