// morris.bot
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Morris - runs his mouth through the firefight, then delivers when it matters.
// Voice: quick, profane, cocky, and competent, with a commentator's instincts.

character "Morris" {
	inherit		"roamer"
	description	"fast-talking comms Marine who delivers under fire"

	skillBand	3 5

	model		"model_player_marine_morris"
	modelMarine	"model_player_marine_morris"
	modelStrogg	"model_player_tactical_transfer"

	// A comms specialist reads the whole map and keeps moving through it.  He
	// takes fights eagerly, but does not abandon the rotation to tunnel after
	// one player.
	set	combatRange		520
	add	aggression		0.12
	scale	itemFocus		0.90
	scale	pursuit			1.15

	// Limitless energy and quick thinking show up as movement and consistency,
	// while the underlying skill level still owns his actual reaction and aim.
	scale	strafeChance		1.15
	scale	jumpChance		1.10
	scale	dodgeReactMsec		0.90
	scale	reactionVarianceMsec	0.90
	scale	targetSelection		1.05
	set	initiative		0.78
	set	suppressionMsec	400
	set	strafeRhythmMsec	180
	set	strafeRhythmVarianceMsec	320
	set	weaponSwitchMsec	250

	// Morris supplies the running commentary in the middle of the action.
	set	chatiness		0.80
	scale	chatDelayScale		0.70

	// His martial-arts background makes the last-resort close options less
	// alien, without turning a disciplined veteran into a gauntlet berserker.
	weapon	"weapon_shotgun"	1.15
	weapon	"weapon_gauntlet"	0.85

}
