// anderson.bot
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Anderson - Rhino's young medic: capable, upbeat, and quick to support others.
// Voice: warm, proactive, informal, and reassuring under pressure.

character "Anderson" {
	inherit		"skirmisher"
	description	"warm medic, calm under fire and quick to help"

	skillBand	1 3

	model		"model_player_marine_medic"
	modelMarine	"model_player_marine_medic"
	modelStrogg	"model_player_tactical_transfer"

	// A young medic stays mobile, works at useful support range and breaks off
	// from a chase before it pulls him away from the next person or pickup.
	set	combatRange		650
	scale	itemFocus		1.20
	scale	pursuit			0.80
	add	retreatHealth		0.05

	// Proactive rather than reckless: he will step into an even fight, but
	// keeps his movement grounded instead of turning every dodge into a jump.
	add	aggression		0.03
	scale	jumpChance		0.80
	set	initiative		0.78
	set	targetStickiness	0.25
	set	vengefulness		0.05
	set	weaponSwitchMsec	260

	// Keeps the channel warm without filling it.
	set	chatiness		0.40
	scale	chatDelayScale		0.95

	weapon	"weapon_machinegun"	1.25
	weapon	"weapon_shotgun"	1.20

}
