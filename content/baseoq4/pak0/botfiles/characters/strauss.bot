// strauss.bot
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Strauss - a brilliant technician forced to prove his intellect in the field.
// Voice: precise, vain, pedantic, and vividly human when control slips.

character "Strauss" {
	inherit		"ambusher"
	description	"brilliant, vain technician with a very human temper"

	skillBand	2 4

	// The tech model carries no team, so it is only legal outside team games;
	// team play falls back to the standard marine and strogg bodies.
	model		"model_player_marine_tech"
	modelMarine	"model_player_marine"
	modelStrogg	"model_player_tactical_transfer"

	// Strauss would rather solve a prepared firing lane than improvise in the
	// open.  He guards useful equipment, avoids pursuit, and withdraws early
	// when his allegedly irreplaceable life is at risk.
	set	combatRange		800
	scale	aggression		0.75
	scale	patience		0.90
	add	retreatHealth		0.12
	scale	pursuit			0.80
	scale	itemFocus		1.10

	// His intellect improves decisions, not his hands: low skill still reacts,
	// aims and dodges like low skill.  When a mistake does happen, field panic
	// makes it linger a little longer.
	scale	weaponSkill		1.07
	scale	targetSelection		1.08
	scale	mistakeMsec		1.10
	scale	dodgeReactMsec		1.05
	set	initiative		0.30
	set	targetStickiness	0.90
	set	opportunism		0.95
	set	suppressionMsec	150
	set	weaponSwitchMsec	900
	set	aimHeight		0.06

	// He always has an explanation, and it is rarely brief.
	set	chatiness		0.70
	scale	chatDelayScale		1.15

	// Engineered energy weapons are the hardware he understands.  Explosives
	// remain usable without making him a second demolitions specialist.
	weapon	"weapon_lightninggun"		1.60
	weapon	"weapon_hyperblaster"		1.45
	weapon	"weapon_rocketlauncher"		1.15
	weapon	"weapon_grenadelauncher"	1.05
	weapon	"weapon_gauntlet"	0.35

}
