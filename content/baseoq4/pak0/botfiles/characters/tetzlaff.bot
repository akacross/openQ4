// tetzlaff.bot
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Tetzlaff - a former range competitor whose reputation always survives the score.
// Voice: polished self-promotion backed by an endless supply of rationalizations.

character "Tetzlaff" {
	inherit		"sniper"
	description	"self-declared marksman whose confidence outruns the score"

	skillBand	1 3

	model		"model_player_marine_helmeted_bright"
	modelMarine	"model_player_marine_helmeted_bright"
	modelStrogg	"model_player_tactical_transfer_bright"

	// Range practice gives him a steady hand and a respectable sight picture.
	// Moving targets expose the gap in that training, and his confidence still
	// releases the shot earlier and wider than a disciplined sniper would.
	scale	aimTremorDeg		0.90
	scale	aimTrackError		1.15
	scale	aimSettleMsec		0.85
	scale	fireConeDeg		1.10

	// Holds range past the point where it helps, barely moves once set, and
	// chooses the impressive target rather than the useful one.  The 1-3 band
	// leaves vision, reactions and mistakes firmly on the low-skill curve.
	scale	combatRange		1.15
	scale	strafeChance		0.85
	add	patience		0.05
	scale	pursuit			0.75
	scale	targetSelection		0.85
	scale	itemFocus		0.85
	set	initiative		0.82
	set	targetStickiness	0.70
	set	opportunism		0.70
	set	suppressionMsec	1200
	set	weaponSwitchMsec	1000
	set	aimHeight		0.16

	// Never shuts up, and is quick about it.
	set	chatiness		0.80
	scale	chatDelayScale		0.85

	weapon	"weapon_railgun"	2.40
	weapon	"weapon_shotgun"	0.25

}
