// bidwell.bot
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Bidwell - Rhino's senior enlisted Marine; hard training keeps Marines alive.
// Voice: gruff, urgent, rank-conscious, and sparing with his approval.

character "Bidwell" {
	inherit		"rusher"
	description	"hard-driving sergeant with no patience for sloppy work"

	skillBand	3 5

	model		"model_player_marine_fatigues"
	modelMarine	"model_player_marine_fatigues"
	modelStrogg	"model_player_tactical_transfer"

	// Bidwell drives forward, but training keeps the charge disciplined: he
	// gives himself a little more room, dodges instead of hopping blindly and
	// maintains enough range control to make the pressure deliberate.
	scale	combatRange		1.35
	scale	aggression		0.93
	add	patience		0.03
	add	rangeDiscipline		0.12
	scale	strafeChance		1.15
	scale	jumpChance		0.75

	// He pursues hard without treating survival and equipment as somebody
	// else's problem.
	scale	pursuit			0.95
	scale	itemFocus		1.15
	add	retreatHealth		0.12

	// Commits to the chosen Marine, keeps rounds going through the doorway,
	// and changes weapon without losing the pressure.
	set	initiative		0.82
	set	targetStickiness	0.82
	set	suppressionMsec	450
	set	strafeRhythmMsec	380
	set	weaponSwitchMsec	300

	// Orders are frequent, short and immediate.
	set	chatiness		0.65
	scale	chatDelayScale		0.85

	weapon	"weapon_rocketlauncher"	1.30
	weapon	"weapon_machinegun"		1.20

}
