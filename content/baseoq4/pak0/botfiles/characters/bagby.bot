// bagby.bot
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Bagby - a junior logistics specialist pressed into combat-simulation duty.
// Voice: fast, friendly, observant, and excessively honest when nerves take over.

character "Bagby" {
	inherit		"roamer"
	description	"chatty, honest novice who learns out loud"

	skillBand	1 2

	model		"model_player_failed_transfer"
	modelMarine	"model_player_marine_helmeted_bright"
	modelStrogg	"model_player_tactical_transfer_bright"

	// Logistics is the one part of the arena he understands.  He follows the
	// item circuit, avoids a long chase, and leaves a bad trade earlier than a
	// front-line Marine would.
	scale	itemFocus		1.20
	scale	pursuit			0.80
	scale	aggression		0.80
	add	retreatHealth		0.05

	// Nerves still cost him the first beat after contact, and at this band he
	// does not hold a useful fighting distance consistently.  Neither modifier
	// substitutes for the deliberately poor skill 1-2 aim curve.
	scale	reactionMsec		1.08
	scale	rangeDiscipline		0.85

	// Nerves make him shoot first and think about equipment afterward.  His
	// fire is frequent but low, and he is slow to change away from a poor
	// weapon choice.
	set	initiative		0.78
	set	targetStickiness	0.18
	set	vengefulness		0.05
	set	suppressionMsec	1600
	set	weaponSwitchMsec	850
	set	aimHeight		-0.10

	// The chattiest bot on the roster by a wide margin, and the fastest typer.
	set	chatiness		0.95
	scale	chatDelayScale		0.70

	// Reaches for straightforward issue weapons and treats specialist hardware
	// as a last resort.
	weapon	"weapon_machinegun"		1.30
	weapon	"weapon_hyperblaster"		1.20
	weapon	"weapon_rocketlauncher"		0.90
	weapon	"weapon_lightninggun"		0.90
	weapon	"weapon_grenadelauncher"	0.65
	weapon	"weapon_railgun"		0.55

}
