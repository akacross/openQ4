// gunner.bot
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Gunner - an arena adaptation of the retail Strogg assault unit.
// Voice: readable translated combat traffic: targets, nails, grenades, outcomes.

character "Gunner" {
	inherit		"rusher"
	description	"translated Strogg combat traffic: target, suppress, advance"

	skillBand	3 5

	model		"model_player_marine_fatigues"
	modelMarine	"model_player_marine_fatigues"
	modelStrogg	"model_player_tactical_transfer_bright"

	// An assault unit advances, but its integrated nailgun and grenade launcher
	// need more room than a human shotgun rush.  Once it acquires a target it
	// maintains suppression and follows the retreat.
	set	combatRange		380
	add	rangeDiscipline		0.08
	scale	pursuit			1.10
	scale	retreatHealth		0.75

	// Long, closely spaced bursts sell the ammunition-feed machinery.  Target
	// selection and tracking are consistent without replacing the 3-5 skill
	// curve that determines how accurate those bursts actually are.
	scale	burstMaxMsec		1.35
	scale	burstPauseMsec		0.75
	scale	aimTrackError		0.90
	scale	reactionVarianceMsec	0.90
	scale	targetSelection		1.08
	set	initiative		0.92
	set	targetStickiness	0.88
	set	suppressionMsec	900
	set	strafeRhythmMsec	320
	set	weaponSwitchMsec	260

	// Talks a fair amount, always in compact combat reports.
	set	chatiness		0.60
	scale	chatDelayScale		0.95

	// Character entries replace the rusher's opinions.  Nails are the primary
	// feed, grenades are the ranged alternative, and the human machinegun is
	// deliberately not treated as the unit's integrated weapon.
	weapon	"weapon_nailgun"		3.00
	weapon	"weapon_grenadelauncher"	2.20
	weapon	"weapon_gauntlet"		0.60
	weapon	"weapon_shotgun"		0.60
	weapon	"weapon_machinegun"		0.60
	weapon	"weapon_railgun"		0.40

}
