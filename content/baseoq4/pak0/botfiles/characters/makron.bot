// makron.bot
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Makron - the top of the roster, and aware of it.  Only ever appears at
// bot_skill 5, which is the point: this is what the ceiling sounds like.
// Voice: terse, imperious threats from a ruler who treats resistance as error.

character "Makron" {
	inherit		"hunter"
	description	"Strogg ruler issuing threats, never conversation"

	skillBand	5 5

	model		"model_player_tactical_command"
	modelMarine	"model_player_marine_helmeted"
	modelStrogg	"model_player_kane_strogg"

	// The most composed acquisition on the roster, but still subject to the
	// skill 5 tremor and fire cone.  This is a ceiling, not an aimbot.
	scale	reactionMsec		0.90
	scale	aimTremorDeg		0.85
	scale	aimTrackTimeConst	0.90
	scale	reacquireMsec		1.15
	scale	reacquireFraction	0.90

	// The ruler identifies the greatest threat, declares it primary, and hunts
	// it until authority is restored.
	scale	sightRange		1.08
	scale	targetSelection		1.20
	scale	weaponSkill		1.05
	scale	pursuit			1.10
	add	aggression		0.08
	set	initiative		0.75
	set	targetStickiness	1.00
	set	vengefulness		1.00
	set	suppressionMsec	650
	set	aimHeight		0.12

	// Speaks rarely and slowly, and never twice about the same thing.
	set	chatiness		0.25
	scale	chatDelayScale		1.30

	weapon	"weapon_railgun"	1.30
	weapon	"weapon_lightninggun"	1.20
	weapon	"weapon_blaster"	0.30

	skill 5 {
		scale	fireConeDeg		0.90
		add	aimLead			0.02
	}

}
