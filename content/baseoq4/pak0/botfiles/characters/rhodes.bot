// rhodes.bot
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Rhodes - a Texas demolitions expert who treats every match like a good time.
// Voice: warm, exuberant, coarse, and loyal, with craftsman's pride.

character "Rhodes" {
	inherit		"ambusher"
	description	"rowdy demolitions expert with a craftsman's pride"

	skillBand	3 5

	model		"model_player_marine_officer"
	modelMarine	"model_player_marine_officer"
	modelStrogg	"model_player_kane_strogg"

	// Rhodes chooses the weak point and lets the target enter it.  He is more
	// willing than a textbook ambusher to push out and finish the work, but he
	// still treats positioning and patience as part of the demolition.
	set	combatRange		650
	scale	aggression		1.60
	scale	patience		0.82
	scale	strafeChance		1.15
	scale	pursuit			1.10

	// His craft is placing explosive force where a moving target will be.  The
	// multipliers preserve the large lead-error gap between low and high skill.
	scale	aimLead			1.08
	scale	aimLeadError		0.90
	set	initiative		0.70
	set	targetStickiness	0.80
	set	suppressionMsec	1000
	set	weaponSwitchMsec	500

	// Rhodes enjoys the show and does not keep that enjoyment to himself.
	set	chatiness		0.60
	scale	chatDelayScale		0.85

	// Biases are final absolute scores, not multipliers.  Grenades need the
	// larger number because their base ordering otherwise leaves them behind
	// ordinary close-range choices even in a demolitions expert's hands.
	weapon	"weapon_rocketlauncher"		1.85
	weapon	"weapon_grenadelauncher"	3.25

}
