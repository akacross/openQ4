// kane.bot
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Kane - a quiet survivor whose reserve predates his Stroggification.
// Voice: extremely sparse, plain human tactical speech; action over commentary.

character "Kane" {
	inherit		"skirmisher"
	description	"quiet survivor who lets the result speak"

	skillBand	4 5

	model		"model_player_tactical_elite"
	modelMarine	"model_player_marine"
	modelStrogg	"model_player_kane_strogg"

	// Machine-steady where the archetype is merely mobile.  The tremor and the
	// tracking lag are the two places the implants show.
	scale	aimTremorDeg		0.85
	scale	aimTrackTimeConst	0.90
	scale	turnDamping		1.10

	// Kane closes to a practical mid-range, commits when the trade is sound and
	// moves with control rather than showing off.
	set	combatRange		700
	add	aggression		0.07
	add	patience		0.07
	scale	strafeChance		1.05
	scale	jumpChance		0.85

	// Survival remains the priority: he leaves on the number and refuses to
	// let a retreating opponent pull him off the larger task.
	add	retreatHealth		0.05
	scale	pursuit			0.85
	set	initiative		0.60
	set	targetStickiness	0.75
	set	vengefulness		0.80
	set	suppressionMsec	150
	set	weaponSwitchMsec	250
	set	aimHeight		0.05

	// Almost silent, and deliberate when he does speak.
	set	chatiness		0.18
	scale	chatDelayScale		1.25

	weapon	"weapon_railgun"		1.15
	weapon	"weapon_hyperblaster"	1.25

	skill 5 {
		scale	aimTrackError		0.90
		add	rangeDiscipline		0.04
	}

}
