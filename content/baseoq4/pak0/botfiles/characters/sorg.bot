// sorg.bot
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Sorg - a reconnaissance pathfinder who is always choosing the next route.
// Voice: rapid, sensory, and mobile, with only an occasional interrupted thought.

character "Sorg" {
	inherit		"skirmisher"
	description	"restless pathfinder always reading the next opening"

	skillBand	2 4

	model		"model_player_slimy_transfer"
	modelMarine	"model_player_marine_fatigues"
	modelStrogg	"model_player_tactical_transfer_bright"

	// Even less willing to stand and trade than the archetype.  Shorter
	// bursts, more jumping, quicker dodges, and an earlier break-off.
	scale	burstMaxMsec		0.85
	scale	jumpChance		1.15
	scale	dodgeReactMsec		0.90
	add	retreatHealth		0.05
	scale	patience		0.72

	// A pathfinder notices movement at the edge of the view, then keeps moving
	// through the rotation rather than holding the angle or chasing the contact.
	scale	sightRange		1.05
	scale	peripheralPenaltyMsec	0.90
	scale	itemFocus		1.10
	scale	pursuit			0.85
	set	initiative		0.70
	set	targetStickiness	0.15
	set	suppressionMsec	150
	set	strafeRhythmMsec	140
	set	strafeRhythmVarianceMsec	300
	set	weaponSwitchMsec	200
	set	aimHeight		-0.03

	// Types quickly and changes subject when fresh movement catches the eye.
	set	chatiness		0.65
	scale	chatDelayScale		0.80

	// Mobile automatic weapons suit the route; a railgun asks him to become
	// the still target he is trained not to present.
	weapon	"weapon_nailgun"		1.45
	weapon	"weapon_hyperblaster"		1.35
	weapon	"weapon_railgun"		0.70

}
