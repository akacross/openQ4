// marsh.bot
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Marsh - a transport liaison who makes temporary crews work like a team.
// Voice: warm, observant, and generous, but still intent on winning.

character "Marsh" {
	inherit		"roamer"
	description	"warm competitor who notices and respects good play"

	skillBand	2 4

	model		"model_player_marine"
	modelMarine	"model_player_marine"
	modelStrogg	"model_player_tactical_transfer"

	// An adaptable liaison rather than a duelist: runs the rotation, takes the
	// useful fight, and refuses to tunnel after somebody who has already left.
	add	aggression		0.04
	add	patience		0.05
	scale	pursuit			0.90
	scale	itemFocus		1.05
	scale	targetSelection		1.05
	set	initiative		0.60
	set	targetStickiness	0.30
	set	opportunism		0.85
	set	vengefulness		0.05

	// The most talkative of the roamers by a distance.
	set	chatiness		0.85
	scale	chatDelayScale		0.90

	// No character-level weapon bias: he is a practiced generalist and uses
	// whatever the roamer's route provides.

}
