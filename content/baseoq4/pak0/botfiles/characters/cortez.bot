// cortez.bot
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Cortez - a composed sharpshooter who makes difficult angles look ordinary.
// Voice: courteous, deliberate, and quietly warm, with restrained confidence.

character "Cortez" {
	inherit		"sniper"
	description	"courteous sharpshooter with calm, exact confidence"

	skillBand	3 5

	model		"model_player_marine_cortez"
	modelMarine	"model_player_marine_cortez"
	modelStrogg	"model_player_tactical_transfer"

	// Holds a little farther out than the archetype and relocates just enough
	// to find a better angle instead of treating one firing point as sacred.
	set	combatRange		1550
	add	aggression		0.05
	scale	patience		0.90
	scale	strafeChance		1.10
	scale	pursuit			0.85
	scale	itemFocus		0.95

	// Marksmanship is composure, not a replacement skill curve: every level
	// keeps its native reaction and tracking limits, but Cortez wastes less of
	// the shot on tremor, indecision and an optimistic trigger.
	scale	reactionVarianceMsec	0.85
	scale	aimTremorDeg		0.90
	scale	fireConeDeg		0.90
	scale	targetSelection		1.05
	set	initiative		0.32
	set	targetStickiness	0.90
	set	weaponSwitchMsec	650
	set	aimHeight		0.14

	// Deliberate on comms, as he is on the trigger.
	set	chatiness		0.45
	scale	chatDelayScale		1.10

	// An absolute preference layered over the sniper's weapon table.  This is
	// strong enough to define him without making rail the right close-range
	// answer when a lightning gun is available.
	weapon	"weapon_railgun"	2.20

}
