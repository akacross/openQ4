// hollenbeck.bot
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Hollenbeck - a Viper Squad lieutenant restoring order to a damaged operation.
// Voice: practical field command: objective, reason, deadline.

character "Hollenbeck" {
	inherit		"roamer"
	description	"field lieutenant who turns every setback into an order"

	skillBand	2 4

	model		"model_player_marine_helmeted"
	modelMarine	"model_player_marine_helmeted"
	modelStrogg	"model_player_tactical_transfer"

	// Hollenbeck plays the operation rather than one doorway: he controls the
	// useful parts of the map, holds gains and abandons chases that threaten
	// the next objective.
	set	combatRange		680
	scale	aggression		0.92
	add	patience		0.12
	scale	itemFocus		1.10
	scale	pursuit			0.82
	add	rangeDiscipline		0.07
	add	retreatHealth		0.07

	// An officer should usually recognise the important threat, while the
	// underlying skill curve still decides how often that judgment is right.
	scale	targetSelection		1.05
	set	initiative		0.50
	set	targetStickiness	0.65
	set	opportunism		0.70
	set	weaponSwitchMsec	350

	// Keeps the channel active with running field orders.
	set	chatiness		0.55
	scale	chatDelayScale		0.90

	weapon	"weapon_machinegun"	1.25

}
