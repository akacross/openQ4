// sledge.bot
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Sledge - a formidable heavy-weapons Marine with a quiet sense of duty.
// Voice: reserved, thoughtful, formal, and dryly understated.

character "Sledge" {
	inherit		"rusher"
	description	"soft-spoken heavy Marine with dry, formal restraint"

	skillBand	4 5

	model		"model_player_marine_helmeted"
	modelMarine	"model_player_marine_helmeted"
	modelStrogg	"model_player_tactical_transfer_bright"

	// Still a pressure fighter, but a deliberate heavy-weapons Marine rather
	// than a knife-range brute.  Scaling range and aggression preserves the
	// rusher style's safer low-skill adjustments instead of overwriting them.
	scale	combatRange		1.55
	scale	aggression		0.85
	scale	rangeDiscipline		1.10
	scale	strafeChance		0.90
	scale	jumpChance		0.75
	scale	retreatHealth		0.90
	scale	itemFocus		1.05

	// Heavy automatic weapons stay working for longer, with a measured pause
	// before the next burst.
	scale	burstMaxMsec		1.10
	scale	burstPauseMsec		0.90
	set	initiative		0.70
	set	targetStickiness	0.80
	set	suppressionMsec	500
	set	strafeRhythmMsec	650

	// Barely speaks, and chooses his words instead of blurting them out.
	set	chatiness		0.30
	scale	chatDelayScale		1.05

	// These replace the rusher's absolute weapon scores.  Rockets and sustained
	// energy fire define the heavy specialist; fists remain an emergency
	// fallback rather than his identity.
	weapon	"weapon_rocketlauncher"	1.40
	weapon	"weapon_hyperblaster"	1.70
	weapon	"weapon_nailgun"	1.55
	weapon	"weapon_shotgun"	1.10
	weapon	"weapon_gauntlet"	0.80

}
