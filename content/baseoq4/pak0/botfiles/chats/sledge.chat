// sledge.chat
//
// Dialogue for Sledge. Traits and models live in ../characters/sledge.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Sledge" {
	chat entergame {
		"Sledge, reporting. I am ready."
		"Good to see you. Let us begin."
		"I hope this is a worthy match."
		"Sledge is present. We may begin."
		"I am prepared. I trust you are as well."
		"It is good to return to honest competition."
		"Weapons are ready. There is little else to discuss."
		"I have arrived. Please do not make a ceremony of it."
	}
	chat levelstart {
		"$map. We should proceed carefully."
		"Take a moment. Then we begin."
		"The field is clear. Let us make good use of it."
		"$map appears serviceable. We shall test that."
		"There is room here to work without crowding."
		"We should learn the ground before it learns us."
		"Choose your position well. Changing it may be unpleasant."
		"Everything is in order. That is usually temporary."
	}
	chat kill {
		"That was decisive."
		"You chose an unfortunate approach, $other."
		"You fought well. I was better prepared."
		"$weapon proved sufficient."
		"The matter is concluded."
		"$other, your effort deserved a better result."
		"A measured burst was sufficient."
		"I believe the $weapon made my argument clearly."
	}
	chat killGauntlet {
		"That became unnecessarily close."
		"I would have preferred more distance."
		"$other, I suspect neither of us intended that."
		"This was hardly a dignified solution."
		"$other, we have both had better ideas."
		"I found no elegant alternative."
		"Please maintain a more reasonable distance."
		"I seem to have misplaced the heavy weapon."
	}
	chat killStreak {
		"I have found a useful rhythm."
		"Let us not become careless."
		"The advantage is growing."
		"Three engagements resolved. We continue."
		"Success is becoming a responsibility."
		"I am doing well. This is not permission for carelessness."
		"The opposition is persistent. I respect that."
		"A useful sequence, though the match remains unsettled."
	}
	chat revenge {
		"That settles our previous disagreement."
		"You made your point earlier. I have made mine."
		"I have corrected my mistake."
		"$other, we may now consider the account balanced."
		"I required one correction. It is complete."
		"Your earlier success was instructive."
		"There was no anger in that. Very little, at least."
		"I have answered you. Let us proceed."
	}
	chat death {
		"Well fought, $other."
		"I underestimated you. I shall not do so again."
		"You handled that $weapon well."
		"That was my failure, not yours."
		"$other, your preparation was superior."
		"The $weapon was well chosen. Unfortunately."
		"I should have protected that approach."
		"I am down. Do not mistake silence for surrender."
	}
	chat deathAccident {
		"That error was mine."
		"I should have shown greater care."
		"An embarrassing but useful lesson."
		"There is no dignified report for that."
		"I acted before considering the consequence."
		"The ground has made its objection clear."
		"A regrettable misuse of momentum."
		"I accept full responsibility. Reluctantly, but fully."
	}
	chat itemDenied {
		"You were patient, $other. The $item is yours."
		"I needed that. I shall adapt."
		"Very well. You reached it first."
		"The $item would have been useful. I shall manage."
		"$other, you judged the timing correctly."
		"I will not trade my life for equipment."
		"The resource is gone. Complaining will not restore it."
		"You were quicker. There is no shame in admitting it."
	}
	chat leadTaken {
		"I have the lead. I intend to preserve it."
		"An advantage is a duty, not a comfort."
		"A satisfactory position."
		"We are ahead. I shall treat that as a responsibility."
		"First place changes nothing about the work."
		"I have earned an advantage, not a rest."
		"The score is favorable. I shall not celebrate yet."
		"$other, your pressure has been useful."
	}
	chat leadLost {
		"$other has the lead. I must answer."
		"No panic. There is time to recover."
		"The advantage has shifted, nothing more."
		"$other has made the better adjustment."
		"The score has turned. So must I."
		"I allowed the advantage to become comfortable."
		"There is no need for anger. Action will suffice."
		"I will recover the lead properly, not desperately."
	}
	chat matchWin {
		"That was a strong match. Well fought."
		"Victory is welcome. The effort mattered more."
		"I had to earn that. Thank you."
		"A worthy result against worthy opposition."
		"We remained composed. That made the difference."
		"I am pleased, though I see no need to shout."
		"The result was good. The conduct was better."
		"Thank you. I learned something useful."
	}
	chat matchLose {
		"The victory was deserved. Well fought."
		"I have work to do. Good game."
		"I know where I failed. I will do better."
		"I was not equal to this match."
		"There is no dishonor in a lesson honestly earned."
		"The failure is clear. I shall address it."
		"You fought with discipline. I respect that."
		"I will carry the lesson, not the excuse."
	}
	chat farewell {
		"Sledge signing off. Good games."
		"I must leave. Fight well."
		"Until next time. Take care of yourselves."
		"I have spoken enough for one session."
		"Goodbye. I hope we meet under favorable circumstances."
		"I am leaving. Please continue without unnecessary risk."
		"Thank you for the competition. It was worthwhile."
		"Sledge out. I wish you steady hands."
	}
	chat order {
		"I understand, $other. I shall go."
		"Very well. It shall be done."
		"Your request is fair. I comply."
		"I accept this task."
		"I will do as you ask, $other."
		"It is a good plan. I am going."
		"So be it. I shall hold to it."
		"You may rely on me."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Find cover first, $other. Pride can recover later."
		"Do not rush. A careful retreat is still progress."
		"Preserve yourself. The next decision matters more."
		"Steady your breathing and choose solid ground."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"A worthy match, $other. Thank you."
		"The contest was demanding and honestly fought."
		"I would be pleased to face such opposition again."
		"That result mattered less than the effort behind it."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"If that is your wish, $other, I shall oblige."
		"If you insist, I shall answer properly."
		"A direct challenge deserves full attention."
		"Come forward. There is no need for theatrics."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"Your voice is welcome, $other."
		"Sledge here. I trust you are prepared."
		"Welcome. Let us proceed without ceremony."
		"Your company is appreciated."
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"No thanks are necessary."
		"There is no debt, $other."
		"Of course. It was the proper thing."
		"Your gratitude is appreciated."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"Thank you. I shall try to remain worthy of it."
		"A generous assessment, $other."
		"I value your respect more than the score."
		"Your generosity is noted."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"Accepted. We need not carry it further."
		"The mistake is finished, $other."
		"I respect the admission. Let us continue."
		"There is nothing to gain by dwelling on it."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Farewell, $other. Fight wisely."
		"Take care of yourself until we meet again."
		"Your company was worthwhile. Goodbye."
		"Go safely. I hope the next match is worthy."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Sledge"

		"Sledge is listening."
		"You called, $other. Please continue."
		"I am here. What is required?"
		"You have my attention."
	}
}
