// marsh.chat
//
// Dialogue for Marsh. Traits and models live in ../characters/marsh.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Marsh" {
	chat entergame {
		"Marsh here. Good to see some familiar names."
		"Hello, all. Let's make it a close one."
		"Made it. Who's setting the pace this round?"
		"Marsh joining. Good luck; I'll still make you work for it."
		"Marsh reporting. Let's give each other a match worth remembering."
		"Good crowd. Somebody here is going to make me earn my ammunition."
		"I'm in. Play hard, keep it clean, and make the close ones count."
		"New faces, familiar arena. Let's see who reads it first."
	}
	chat levelstart {
		"$map. Plenty of room for a proper fight."
		"$map should keep us busy. Stay sharp."
		"All right, everyone. Clean start and no excuses."
		"$map gives us room to adapt. Use it."
		"Fresh start. Watch the first pickup; it usually tells the story."
		"All set. Let's make every mistake expensive."
		"$map rewards patience until somebody breaks it. I'll volunteer."
		"Round's live. Show me something I have to remember."
	}
	chat kill {
		"That corner caught you, $other. Watch it next time."
		"You made me work for that one, $other."
		"The $weapon found the gap. Close fight."
		"You nearly had me there. I mean that."
		"You nearly turned that one, $other. The $weapon settled it."
		"Good pressure, $other. I had one opening and used it."
		"You made the right move a second late."
		"That was a clean exchange. Thanks for making it close."
	}
	chat killGauntlet {
		"$other, we both knew that was going to get ugly."
		"That got much closer than either of us planned."
		"Nothing personal. You left the door open."
		"Too close for comfort, $other. Just close enough for the finish."
		"You crowded me and I took the invitation."
		"That became a fistfight quicker than either of us deserved."
		"$other, next time leave a little room for dignity."
		"No elegant answer there. The direct one worked."
	}
	chat killStreak {
		"Three in a row. Who wants the next chance?"
		"I'm finding my rhythm now."
		"Keep the pressure on me, or this gets away from you."
		"Three straight. You're giving me too much room to settle in."
		"I'm holding the tempo now. Make me give it back."
		"That's a proper run. Somebody interrupt it."
		"Three good fights, three narrow openings."
		"The round is leaning my way. Push harder."
	}
	chat revenge {
		"Got the return, $other. We're having a proper duel now."
		"That evens us up. Next one decides it."
		"I knew you'd come back through there, $other."
		"I remembered your angle, $other. You needed a new one."
		"There, we're square. Now let's make the next fight clean."
		"$other, that earlier lesson was useful. Here's the result."
		"I knew you'd test that approach again."
		"One returned. No grudge, just good accounting."
	}
	chat death {
		"Beautiful angle, $other. I never saw it."
		"Well played. You made me commit too early."
		"The $weapon was the right call there."
		"Clean finish, $other. I'll adjust."
		"You waited me out, $other. That was the right choice."
		"Clean work with the $weapon. I chased the wrong opening."
		"I saw the move and still committed. Well earned."
		"That was patient play. I gave you exactly what you wanted."
	}
	chat deathAccident {
		"I managed that one without any assistance."
		"Wrong step, wrong time. That's mine."
		"Nobody's fault but mine. Resetting."
		"I read the fight and forgot to read the floor."
		"That path looked better before the last step."
		"A preventable mistake, which makes it mine twice."
		"I got ahead of myself. Resetting."
		"No opponent needed. I supplied the bad decision."
	}
	chat itemDenied {
		"Sharp timing on the $item, $other."
		"You won that route. I'll contest the next one."
		"Sharp pickup. Don't expect the next spawn for free."
		"You read the spawn well, $other. That $item was yours."
		"I saw the $item; you saw the clock. Nicely done."
		"Good contest, $other. I'll arrive first next time."
		"That pickup gives you an edge. Let's see what you do with it."
		"I gave up the $item by taking one fight too many."
	}
	chat leadTaken {
		"Lead's mine. Now the hard part is keeping it."
		"Top for the moment. Come and take it."
		"Strong round so far. I'm setting the pace."
		"I'm in front. Keep it close enough to stay interesting."
		"Lead secured. Now show me how you plan to break it."
		"I've got the pace. Don't let me get comfortable."
		"Top spot for now. There's plenty of round left."
		"That's the lead. Good pressure got me here."
	}
	chat leadLost {
		"Nicely done, $other. I'm coming for it."
		"There goes the lead. Time to earn it back."
		"$other has the momentum. Let's change that."
		"Lead changed hands. The match just got better."
		"$other earned the front. I intend to make it temporary."
		"I let the pace slip. I know why."
		"I'm behind now. Good; I know what needs doing."
		"The top spot moved. My next fight matters."
	}
	chat matchWin {
		"That was worth remembering. Thanks for keeping me honest."
		"That was close right to the end. Thanks, all."
		"Well played, everyone. I had to fight for every point."
		"Fine match. Everyone gave me something different to solve."
		"That one stayed competitive. Exactly how I like it."
		"Strong round, all. The win feels earned."
		"Good pressure from start to finish. Thanks for the match."
		"I got the result, but nobody made it comfortable."
	}
	chat matchLose {
		"Good win. Next round is mine."
		"You earned it. I'll be ready for the rematch."
		"I know the moment that got away from me. Nicely played."
		"Well earned. I had chances and didn't use enough of them."
		"That was competitive to the end. I'll take the lesson and the rematch."
		"I chased one fight too many. You made me pay for it."
		"You had the better round. Mine is coming."
		"I know the turning point. Next time I answer it."
	}
	chat farewell {
		"That's me done. Good games, everyone."
		"Thanks for the rounds. See you next time."
		"Marsh out. Keep the next round lively."
		"I'm calling it there. Thanks for keeping the rounds honest."
		"Take care, everyone. Save me a place in the next close match."
		"I'm heading out. You were good company and difficult opponents."
		"That's enough for me. Keep making each other work."
		"See you next time. Bring the same pressure."
	}
	chat order {
		"Sure thing, $other. I'm on it."
		"Sounds like a plan. Heading over."
		"Okay, I'll take that. Good call."
		"You got it. I'll make it count."
		"Happy to, $other. Let's keep it close."
		"On my way. Shout if it changes."
		"Fair enough. I'll cover that."
		"Right behind the plan, $other."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Take cover first, $other. Give yourself room to think."
		"Slow the problem down. One safe choice at a time."
		"Keep your head up and your route simple."
		"Protect yourself. The score can wait."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"That was a fine match, $other. Thanks."
		"You made every point feel earned. I enjoyed that."
		"Good competition from beginning to end."
		"I would gladly share another round with this crowd."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"Gladly, $other. Let's make it memorable."
		"All right. Bring your best and keep it clean."
		"A challenge from you? Now the match gets interesting."
		"You're on. I hope neither of us makes it easy."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"Hello, $other. Glad you spoke up."
		"Good to hear from you. How is the match treating you?"
		"Welcome. The company just improved."
		"Marsh here. Nice to meet you properly."
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"Gladly, $other. It was no burden."
		"Glad I could make things easier."
		"Any time. Courtesy matters."
		"No trouble at all. Keep doing what works."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"That is kind of you to say."
		"Thanks, $other. You made the effort worth it."
		"I appreciate that from someone who knows good play."
		"You noticed the part I worked for. Thank you."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"No hard feelings, $other."
		"Accepted. Let's give the next moment a clean start."
		"It happens. I appreciate you owning it."
		"We're fine. Keep enjoying the match."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Take care, $other. You were good company."
		"Thanks for the rounds. I hope we meet again."
		"Safe travels. Bring the same fight next time."
		"Goodbye for now. You will be welcome back."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Marsh"

		"Marsh here. What can I do for you?"
		"Is that for me, $other?"
		"I hear you. Go ahead."
		"Yes? You've got my attention."
	}
}
