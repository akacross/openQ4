// strauss.chat
//
// Dialogue for Strauss. Traits and models live in ../characters/strauss.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Strauss" {
	chat entergame {
		"Strauss has arrived. You may now expect competent opposition."
		"Johann Strauss, ready. Try to keep up."
		"Very well. Let us see whether this match rewards intelligence."
		"I have reviewed the opposition. The forecast is favorable."
		"Try not to damage anything I may need later."
		"My equipment is calibrated. I assume yours is merely functional."
		"At last, a problem with measurable results."
		"Proceed. I have already lost enough time."
	}
	chat levelstart {
		"$map. Crude architecture, but useful sightlines."
		"I have already identified the efficient routes."
		"Observe carefully. I dislike repeating demonstrations."
		"$map. At least the geometry is comprehensible."
		"The useful choke points are obvious. To some of us."
		"I require thirty seconds to make this layout predictable."
		"Do not confuse movement with strategy."
		"The equipment cycle is inefficient, but exploitable."
	}
	chat kill {
		"Interesting approach, $other. Fatally incomplete."
		"That angle was elementary."
		"$weapon was appropriate. My timing made it effective."
		"You nearly made that difficult."
		"$other, your plan failed at the first assumption."
		"The $weapon performed within expected tolerances."
		"You presented a simple problem."
		"That outcome required remarkably little effort."
	}
	chat killGauntlet {
		"How undignified. For both of us."
		"At that range, even you should have seen me."
		"Effective, yes. Civilized, no."
		"This is not how an educated man should have to fight."
		"$other, you reduced us both to improvisation."
		"An inelegant solution remains a solution."
		"Please maintain a civilized distance."
		"I dislike experiments with such a small margin."
	}
	chat killStreak {
		"Consistency is what separates skill from accident."
		"At last, the board reflects the evidence."
		"Do keep trying. Repetition may improve you."
		"Three results now support my conclusion."
		"The pattern is stable. Your prospects are not."
		"My performance is becoming statistically difficult to ignore."
		"Competence looks effortless only from a distance."
		"At this rate, even command may notice."
	}
	chat revenge {
		"I have corrected your temporary anomaly."
		"Your earlier success required an answer."
		"We are even, $other. Briefly."
		"Correction complete, $other."
		"Your advantage was based on incomplete information."
		"I have incorporated the previous failure."
		"That restores the proper ordering."
		"You were useful calibration, $other."
	}
	chat death {
		"Nein. That angle should have been covered."
		"A competent shot, $other. Do not become insufferable."
		"That $weapon was... regrettably well used."
		"I made an avoidable error. This is deeply irritating."
		"$other identified a flaw. Briefly."
		"The $weapon exploited an unacceptable oversight."
		"I was distracted by everyone else's errors."
		"That was not supposed to happen."
	}
	chat deathAccident {
		"No one saw that. Excellent."
		"An elementary miscalculation, and entirely mine."
		"I refuse to discuss the physics of what just happened."
		"The route model omitted one rather important edge."
		"I converted a minor error into a complete embarrassment."
		"That outcome will not appear in my report."
		"I calculated correctly and stepped incorrectly."
		"A momentary failure of field judgment. Nothing more."
	}
	chat itemDenied {
		"$other took the $item. Irritating, but recoverable."
		"My timing was precise. Yours was simply better."
		"Enjoy it. I have already revised the route."
		"$other has the $item. An inefficient allocation."
		"The $item would be safer in competent hands."
		"I missed the timing by an offensively small margin."
		"Very well. I shall win without that advantage."
		"Resource denied. The revised plan is already better."
	}
	chat leadTaken {
		"First place. Order has been restored."
		"The standings have finally become rational."
		"Naturally, I am leading."
		"The lead is merely catching up with the analysis."
		"First place is the minimum acceptable result."
		"My position is secure. For the moment."
		"The board now reflects a sensible hierarchy."
		"Predictable, yes. Satisfying nonetheless."
	}
	chat leadLost {
		"$other is ahead. That requires immediate correction."
		"Ja, enjoy your statistical outlier."
		"The lead has shifted. I find this unacceptable."
		"$other has introduced an irritating variable."
		"The standings are temporarily misleading."
		"I require one clean correction."
		"This deficit is small and therefore insulting."
		"No matter. The model has been updated."
	}
	chat matchWin {
		"A predictable victory, though you offered useful resistance."
		"Good game. Several of you almost impressed me."
		"The result is correct. The process was occasionally interesting."
		"Victory confirms the method, as expected."
		"A useful exercise. Some of you even adapted."
		"The final margin was entirely reasonable."
		"I accept your congratulations in advance."
		"An orderly result at last."
	}
	chat matchLose {
		"That result requires a detailed explanation."
		"An anomalous result. Still, well played."
		"I underestimated you. That will not happen twice."
		"The method was sound. My execution requires review."
		"I concede the result, not the underlying argument."
		"Someone found a flaw. I intend to find it first."
		"Very well. The evidence favors a rematch."
		"I performed below specification. Temporarily."
	}
	chat farewell {
		"Strauss is leaving. You may lower your expectations."
		"Good games. I have more important systems to examine."
		"Enough field work. I am signing off."
		"My contribution here is complete."
		"I am leaving before the standards deteriorate further."
		"Strauss out. Preserve whatever you managed to learn."
		"I have collected enough field data from this exercise."
		"Until next time. Improve in my absence."
	}
	chat order {
		"A reasonable order, $other. I accept."
		"Very well. I shall apply some intelligence to it."
		"Agreed. It is, coincidentally, what I would have done."
		"Acknowledged. Try to keep the rest of the plan this sensible."
		"If you insist, $other. Executing with precision."
		"Logical. I am proceeding."
		"Fine. I will make it look effortless."
		"Order noted. Expect a competent result."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Find cover, $other. Panic is not a strategy."
		"Reduce your exposure before requesting miracles."
		"Preserve your resources and reconsider the route."
		"The efficient answer is retreat, reassess, then engage."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"A worthwhile match, $other. Statistically unusual."
		"The opposition was competent enough to be interesting."
		"Good contest. The evidence supports a rematch."
		"That exercise produced several respectable decisions."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"Accepted, $other. I welcome a simple problem."
		"Very well. Present your best argument."
		"You challenge me with remarkably little data."
		"Proceed. I have already modeled the likely result."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"Strauss here. Try to be concise."
		"Ja, I hear you, $other."
		"Welcome. Competent conversation would be refreshing."
		"Your signal is clear. Continue."
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"Your gratitude is appropriately directed."
		"Yes, yes. You are welcome."
		"Acknowledgment accepted, $other."
		"Think nothing of it. I solved the difficult part."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"At last, an accurate assessment."
		"Thank you, $other. Your standards may be improving."
		"I accept the compliment as supporting evidence."
		"A qualified observer would reach the same conclusion."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"Apology accepted. Correct your method."
		"An error admitted is marginally less irritating."
		"Very well, $other. Do not corrupt the next result."
		"I shall omit the incident from my analysis."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Goodbye, $other. Improve before we meet again."
		"Strauss acknowledges your departure."
		"Go. I have enough data from you."
		"Until next time. Use the interval productively."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Strauss"

		"Strauss speaking. State the problem."
		"Your summons reached the correct mind, $other."
		"You have reached the appropriate expert."
		"Ja? Be precise."
	}
}
