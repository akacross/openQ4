// anderson.chat
//
// Dialogue for Anderson. Traits and models live in ../characters/anderson.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Anderson" {
	chat entergame {
		"Anderson here. Call out if you're hurt."
		"Medic's ready. Let's get moving."
		"Good to see you, Marines. Stay sharp."
		"Anderson reporting. I'll keep an eye on you."
		"Glad to be here. Tell me when you need help."
		"All set. Stay close if things get rough."
		"Let's look after each other out there."
		"Ready to work. Nobody gets left behind."
	}
	chat levelstart {
		"$map. Watch each other's backs."
		"Check your kit. We're moving."
		"Keep your head down and breathe."
		"$map. Keep moving and check your corners."
		"Quick equipment check. Then we move."
		"Easy breaths. First contact decides nothing."
		"Call trouble early. I can't help if I don't know."
		"Stay together where you can."
	}
	chat kill {
		"Got you, $other. Moving on."
		"Clean hit. Stay sharp."
		"The $weapon did its job."
		"Threat down. Who needs help?"
		"You're down, $other. I'm moving."
		"Good contact with the $weapon."
		"Had to stop you there."
		"That one's mine. Stay ready."
	}
	chat killGauntlet {
		"Too close, $other."
		"You gave me no room there."
		"That got personal fast."
		"Sorry, $other. You got too close."
		"No room for either of us there."
		"Back up next time, $other."
		"I'd rather not do that again."
		"Close call. I'm still here."
	}
	chat killStreak {
		"That's three. Keep the pressure up."
		"Three down. Everyone still with me?"
		"Good run. Don't get careless."
		"Three confirmed. Keep your heads up."
		"I'm finding my rhythm."
		"Good stretch. Now stay disciplined."
		"That's three, but this isn't over."
		"Still steady. Let's keep it that way."
	}
	chat revenge {
		"We're square, $other."
		"Had to come back for you."
		"All right. That's settled."
		"Got the answer, $other."
		"That was for earlier, $other."
		"No hard feelings. We're even."
		"I learned from the last one."
		"Back on my feet, back in the fight."
	}
	chat death {
		"I'm down. Keep fighting."
		"Good hit, $other. I'm out."
		"That $weapon got through."
		"Don't stop for me."
		"I took the hit. Keep pressure on."
		"$other got me clean. Stay alert."
		"The $weapon put me down. I'll be back."
		"I'm out for now. Don't lose focus."
	}
	chat deathAccident {
		"My fault. I lost my footing."
		"I'm okay. Resetting."
		"Bad move. I'll learn from it."
		"Lost my balance. That's on me."
		"Wrong step. Resetting now."
		"Nothing broken but my pride."
		"I rushed it. Won't repeat that."
		"Give me a second. I'm coming back."
	}
	chat itemDenied {
		"$other took the $item. Find another route."
		"I needed that, but I'll manage."
		"Missed it. Keep going."
		"$other beat me to the $item. Fair timing."
		"That $item would have helped. I'll adapt."
		"Pickup's gone. Check the next one."
		"All right. I can work without it."
		"Good grab, $other. Keep moving."
	}
	chat leadTaken {
		"I'm ahead. Keep each other covered."
		"We're doing well. Keep it clean."
		"Ahead for now. Plenty left."
		"Lead's ours to protect."
		"Good start. Don't relax yet."
		"I'm in front. Let's keep everyone moving."
		"Nice work so far. Finish strong."
		"The lead helps. It doesn't make us safe."
	}
	chat leadLost {
		"$other's ahead. We can fix that."
		"Lead's gone. Breathe and reset."
		"Stay with it. We're not done."
		"$other took it. Stay calm."
		"We can recover this. One clean fight at a time."
		"Nothing's decided yet."
		"Reset your breathing and find the next opening."
		"I've come back from worse."
	}
	chat matchWin {
		"Good work, everyone. We kept it together."
		"Nice match. You all made me work."
		"Everyone still standing? Good game."
		"Good match. Everyone worked for that."
		"We stayed steady. That's what mattered."
		"Nice work. Take a moment and recover."
		"That's a good result. Thanks, everyone."
		"We got through it together. Well played."
	}
	chat matchLose {
		"That win was earned. We'll be ready next time."
		"Take a breath. We go again."
		"Rough one. Make sure everyone's all right."
		"We're still here. Learn from it."
		"Good match. Let's patch the mistakes."
		"No shame in that one. We get ready again."
		"Check yourself, reset, and come back stronger."
		"We're shaken, not finished. Take a breath."
	}
	chat farewell {
		"Anderson signing off. Take care."
		"That's me done. Stay safe out there."
		"Good games, Marines. See you around."
		"Medic's heading out. Look after yourselves."
		"I'm off. Keep each other standing."
		"Thanks for the matches. Get some rest."
		"Good work out there. Anderson out."
		"Take care, everyone. I'll see you next time."
	}
	chat order {
		"Copy that, $other. I've got you."
		"On it. Holler if you need patching up."
		"Understood. I'll be where you need me."
		"Roger, $other. Moving now."
		"You got it. Keep your head down."
		"Will do. Stay in one piece out there."
		"Heard you, $other. Doc's on the way."
		"Affirmative. I'll keep the team standing."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Find cover, $other. Take one thing at a time."
		"Keep breathing and stay out of the open."
		"Do not panic, $other. Make the next move simple."
		"Protect yourself first. The fight can wait a second."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"Thanks for the match, $other. You fought well."
		"Good competition. I hope you're ready for another."
		"That was hard fought. Everyone kept moving."
		"Well played, $other. Take a breath."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"All right, $other. Keep it clean."
		"If you want the fight, I am ready."
		"Come on, then. Let's see what we can learn."
		"You found me. Make your shot count."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"Good to hear from you, $other."
		"Hey, $other. Stay sharp out there."
		"Glad you made it. Take care of yourself."
		"Anderson here. How are you holding up?"
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"Any time, $other."
		"Of course. Look after yourself."
		"You're welcome. Keep moving."
		"No problem. We help each other."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"Thanks, $other. That means something."
		"I appreciate it. You made me earn that."
		"Good of you to say. Stay ready."
		"I know good work when I see it."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"You're all right, $other. Reset."
		"Forget it. Focus on the next fight."
		"No harm done. Keep your head up."
		"It happens. Learn from it and move."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Take care, $other. Get back safely."
		"Good fighting. I'll see you around."
		"Rest up, $other. Stay sharp."
		"Thanks for checking in. Stay safe."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Anderson"

		"I hear you, $other. What is it?"
		"Go ahead. I'm listening."
		"You called for Anderson?"
		"Here, $other. Tell me what you need."
	}
}
