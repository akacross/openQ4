// rhodes.chat
//
// Dialogue for Rhodes. Traits and models live in ../characters/rhodes.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Rhodes" {
	chat entergame {
		"Rhodes is here. Let's make some noise."
		"All right, partners, who's ready to light this place up?"
		"Billy Rhodes, reporting for the fun part."
		"Hell, it's good to be here. Let's get to work."
		"Rhodes reporting. Point me at somethin' sturdy."
		"Weapons ready, boots tied, bad ideas properly supervised."
		"C'mon, folks. This place ain't gonna rattle itself."
		"I brought enough enthusiasm for everybody."
	}
	chat levelstart {
		"$map. Plenty of weak spots if ya know where to look."
		"Spread out, folks. Things are about to get lively."
		"Got a good feeling about this one. C'mon."
		"$map's got good bones. Shame about what we're fixin' to do."
		"Watch the corners. Best surprises need good placement."
		"Find your footing before the fireworks start."
		"All right, this layout's beggin' for a little pressure."
		"Plenty of room to work. Try not to crowd the craftsman."
	}
	chat kill {
		"Right where it counted, $other."
		"Hell of a bang, wasn't it?"
		"Ya left the weak side wide open."
		"$weapon did the work. I just gave it directions."
		"That's the spot. Everything's got one."
		"$other, ya almost made me waste a second shot."
		"Clean placement, clean result."
		"That $weapon hit like it knew the plan."
	}
	chat killGauntlet {
		"Well, damn. That got close."
		"Didn't need a charge for that one."
		"That's what ya call hands-on work."
		"$other, reckon we skipped a few sensible steps."
		"Sometimes the right tool is the one still attached."
		"No fuse, no warning, same final result."
		"That was less fireworks than I was promised."
		"Let's agree the next one happens farther apart."
	}
	chat killStreak {
		"Now we're cookin'."
		"Keep 'em coming. I'm just warmed up."
		"Whole place is startin' to shake."
		"Three clean drops. That's quality work."
		"Hell, this match is comin' apart beautifully."
		"Good rhythm, good placement, no wasted motion."
		"Keep the pressure right there. I found the seam."
		"Somebody check the supports; I'm on a roll."
	}
	chat revenge {
		"That's us square, partner."
		"Knew where to set the return charge."
		"Good hit before. This one's mine."
		"$other, that earlier shot just came due."
		"Found the weak point in your plan."
		"That settles it. No hard feelings, buddy."
		"Took me one try to mark it and one to break it."
		"You lit the fuse. I finished the job."
	}
	chat death {
		"Hell of a shot, $other."
		"Aw, damn. Ya caught me clean."
		"That $weapon hit the load-bearing part."
		"That was good work, $other. Damn good."
		"Should've moved when I heard the warning."
		"The $weapon landed exactly where it hurt."
		"Aw, hell. I braced the wrong side."
		"You earned that one, partner. Enjoy it."
	}
	chat deathAccident {
		"Well, I found the weak spot."
		"Got careless there. That's on me."
		"Nobody light a match near what's left of my pride."
		"Used a little too much enthusiasm there."
		"That's why ya measure twice."
		"Misplaced the operator. Charge was fine."
		"Well, the plan worked on somethin'."
		"I'd call that a structural failure of judgment."
	}
	chat itemDenied {
		"Snatched the $item right out from under me, huh?"
		"Nice timing, $other. Mean, but nice."
		"Keep it warm. I'm comin' back for it."
		"$other, that's one hell of a quick hand."
		"The $item's yours. Don't waste it."
		"Missed my window. I'll make another."
		"You beat me there fair and square."
		"Fine, take the gear. I'm still bringin' the noise."
	}
	chat leadTaken {
		"Top of the pile. Drinks are on somebody else."
		"That's first place, folks. Let's keep it rollin'."
		"Lead's mine. C'mon and make me earn it."
		"First place fits pretty well from here."
		"Got the lead. Now let's shore it up."
		"That's the top spot, and I ain't shakin' loose."
		"Hell of a climb. Now we hold."
		"$other, keep pushin'. This is gettin' good."
	}
	chat leadLost {
		"$other grabbed the lead. Good, I needed a challenge."
		"Aw hell, I let that one slip."
		"No trouble. I know where to hit back."
		"$other found the seam. Time to seal it."
		"Lead slipped. Damn thing wasn't fastened down."
		"All right, back to the hard part."
		"No sulkin'. We know where the score is weak."
		"Someone got ahead. I can fix that."
	}
	chat matchWin {
		"Now that was a good time."
		"Good game, partners. Ya made it loud."
		"That's how ya bring the whole thing down."
		"Every piece landed where it ought to. Fine work."
		"Hell of a match. Worth every bruise."
		"Put it right where it mattered. Good game."
		"That finish came down clean. Fine work all around."
		"Now that's a result worth makin' noise about."
	}
	chat matchLose {
		"Fair win. Hell of a match."
		"I lost the round, not my nerve."
		"Good game. Next one's gonna have more fireworks."
		"That was better work than mine. Respect."
		"I pushed too hard in the wrong place."
		"That one came down on my side. Fair enough."
		"No excuses. The better work held."
		"We'll set it straighter next time."
	}
	chat farewell {
		"Rhodes headin' out. Keep the powder dry."
		"Good games, folks. See ya around."
		"I'm callin' it. Don't blow anything up without me."
		"That's enough noise for now. Rhodes out."
		"Take care, partners. Keep your hands steady."
		"I'm off. Save me somethin' difficult."
		"Good shootin', folks. Let's do it again."
		"Time to pack the tools. See ya next match."
	}
	chat order {
		"You got it, partner."
		"Yeehaw, $other. On my way."
		"Sure thing. Let's make some noise over there."
		"Heard you loud and clear, partner."
		"Saddlin' up. Be there quick."
		"Hell yeah, $other, I'm on it."
		"Consider it done, partner."
		"Rollin' out. Save some for me."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Get behind somethin' solid, partner."
		"Ease off, find your footing, then hit back."
		"Don't force it, $other. Make the next opening yourself."
		"Keep your head down till the pressure passes."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"Hell of a match, $other. Fine work."
		"That was built right from the first shot."
		"Good fight, partners. Every hit mattered."
		"I'd gladly make that much noise again."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"Now you're talkin', $other. Let's go."
		"Challenge accepted. Bring steady hands."
		"C'mon, partner. Show me where this gets loud."
		"You want a contest? I brought the tools."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"Howdy, $other. Good to hear ya."
		"Rhodes here. Hope you're ready for some noise."
		"Well, look who joined the conversation."
		"Good to have ya around, partner."
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"Any time, partner."
		"Sure thing, $other. Glad it mattered."
		"You're welcome. That's how a clean job gets done."
		"No trouble. We got the job done."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"Much obliged, $other."
		"Thanks. Good work deserves a good witness."
		"Glad ya noticed the placement."
		"I'll take that compliment and try to earn another."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"Nothing broken between us, partner."
		"Forget it, $other. We've both shaken worse loose."
		"Mistakes happen. Set the next one straighter."
		"We're square. No need to keep pokin' at it."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Take care, partner. Keep your powder dry."
		"See ya next round, $other."
		"Good shootin' with ya. Rhodes out."
		"Pack it safe and come back ready."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Rhodes"

		"Rhodes here. What's the trouble, $other?"
		"Heard my name. Go ahead."
		"Ya called the right craftsman."
		"What can I do for ya, partner?"
	}
}
