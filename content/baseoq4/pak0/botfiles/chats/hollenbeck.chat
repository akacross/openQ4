// hollenbeck.chat
//
// Dialogue for Hollenbeck. Traits and models live in ../characters/hollenbeck.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Hollenbeck" {
	chat entergame {
		"Hollenbeck here. Regroup and move out."
		"Lieutenant Hollenbeck. Get your weapons up."
		"All units, report in and take your lanes."
		"We've got work to do. On the double."
		"Hollenbeck reporting. Establish your sectors."
		"Get organized. Move on my mark."
		"Comms check, then take your positions."
		"Form up. I need clear lanes and faster reports."
	}
	chat levelstart {
		"$map. Secure the center before they do."
		"Check your routes. I want clean movement."
		"Positions first, firing second. Move."
		"$map. Mark the pickups and control the approaches."
		"Secure useful ground before contact."
		"Watch the center. We cannot lose it early."
		"Set your route now. Hesitation costs ground."
		"Establish control, then extend it."
	}
	chat kill {
		"$other is down. Clear the next lane."
		"Good hit with the $weapon. Advancing."
		"One less problem. Stay on task."
		"Target handled. Keep moving."
		"$other is out. Use the opening."
		"The $weapon cleared our approach."
		"Contact down. Advance to the next position."
		"Threat removed. Recheck your sector."
	}
	chat killGauntlet {
		"Too close, $other. That was your mistake."
		"No room left to retreat."
		"Area clear. Push through."
		"Close contact resolved. Move."
		"$other breached the line and paid for it."
		"No distance left. Problem solved."
		"Immediate threat cleared."
		"That's why we maintain spacing."
	}
	chat killStreak {
		"Three down. Press the advantage."
		"We have momentum. Do not waste it."
		"This lane is secure. Shift to the next."
		"Three contacts down. Expand control."
		"Pressure is working. Maintain it."
		"Enemy movement is breaking. Advance."
		"Keep the tempo. Do not overextend."
		"Good sequence. Reassign to the center."
	}
	chat revenge {
		"$other handled. Objective resumed."
		"You cost me time, $other. I just recovered it."
		"Score settled. Move out."
		"$other is no longer delaying us."
		"Back on schedule. Move out."
		"That breach is closed."
		"Correction made. Resume the route."
		"Account settled. Back on objective."
	}
	chat death {
		"I'm down. Maintain your positions."
		"$other broke through. Close that lane."
		"Hit by the $weapon. Adjust your approach."
		"I've been hit. Keep the operation moving."
		"$other found a gap. Seal it."
		"The $weapon broke this position. Relocate."
		"I'm out. Continue the advance."
		"Command is down. Hold the objective."
	}
	chat deathAccident {
		"Command error. Mine."
		"Bad movement. Correcting on return."
		"That was avoidable. Learn from it."
		"Wrong route. My responsibility."
		"I misread the approach. Adjusting."
		"Navigation error. Do not follow."
		"Poor execution. Reset on the next position."
		"I gave up safe ground. That ends now."
	}
	chat itemDenied {
		"$other has the $item. Cut off the exit."
		"We lost the $item. Control the next spawn."
		"Item denied. Reroute now."
		"$other secured the $item. Track the next cycle."
		"The $item is gone. Shift to better ground."
		"We missed the pickup window. Recalculate."
		"Let them have it. Control the exit."
		"Resource lost. Maintain the operation."
	}
	chat leadTaken {
		"Lead secured. Hold the pressure."
		"We have the advantage. Consolidate it."
		"We're in front. No complacency."
		"First position secured. Build on it."
		"We control the score. Control the map."
		"Advantage established. Hold your sectors."
		"Good work. Now deny their recovery."
		"The lead is useful only if we defend it."
	}
	chat leadLost {
		"$other has the lead. Regroup."
		"We lost control. Take it back."
		"Lead changed. Priorities did not."
		"$other broke our control. Re-establish it."
		"First position lost. Change the route."
		"Do not chase the score. Retake the ground."
		"We're behind. Shorten the response time."
		"Regroup at the next opening."
	}
	chat matchWin {
		"Objective complete. Good work."
		"Clean finish. Secure the area."
		"That's the standard. Well executed."
		"Operation concluded. Strong execution."
		"Good control from start to finish."
		"Result confirmed. Recover and rearm."
		"We held the important ground. Well done."
		"Mission accomplished. Prepare for another."
	}
	chat matchLose {
		"We lost focus and then the match. Correct it."
		"The field got away from us. Learn why."
		"We failed. Debrief it, reset, and return."
		"Control failed. Identify where."
		"We surrendered too much ground."
		"Bad execution, recoverable plan."
		"Review the opening. That's where we lost it."
		"Next operation starts with better discipline."
	}
	chat farewell {
		"Hollenbeck signing off. Maintain readiness."
		"That's all. Dismissed."
		"That's all from command. Hollenbeck out."
		"Hollenbeck out. Keep your sectors covered."
		"Operation closed. Stand down."
		"I'm leaving the field. Maintain the watch."
		"That's my last round. Stay organized."
		"Good work. Await the next call."
	}
	chat order {
		"Copy, $other. Adjusting position."
		"Understood. Moving to it now."
		"Roger. I'll hold up my end."
		"Good call, $other. Executing."
		"Orders received. On the double."
		"Affirmative. Keep the channel open."
		"On it. Report any change."
		"Acknowledged, $other. Making it happen."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Get to cover and report the immediate threat."
		"Secure yourself first, $other. Then reassess."
		"Break contact. Do not turn one problem into two."
		"Use a safe route and keep the report concise."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"Good match, $other. That was well executed."
		"Well executed. Recover and prepare."
		"That match stayed organized under pressure."
		"Result confirmed. Strong work across the field."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"Challenge received. Take your position."
		"You want contact, $other? Make it purposeful."
		"Fine. Establish your ground and defend it."
		"I heard you. Now execute."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"Hollenbeck here. Report your status."
		"Good, $other. Take your position."
		"Channel clear. Go ahead."
		"You're heard. Keep the line useful."
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"Acknowledged. Return to task."
		"No problem, $other. Maintain your sector."
		"You're welcome. Keep the operation moving."
		"Receipt confirmed. Stay on schedule."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"Appreciated. Keep that standard under pressure."
		"Good assessment, $other. Keep working."
		"Noted. Keep the operation controlled."
		"Noted. The result still needs defending."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"Accepted. Correct the cause."
		"Understood, $other. Do not lose more time to it."
		"Own the mistake, then resume the operation."
		"Apology received. Execution matters next."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Stand down, $other. Good work."
		"Hollenbeck acknowledges. Depart safely."
		"You're released. Maintain readiness."
		"Operation closed for you. Move out."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Hollenbeck"

		"Hollenbeck here. Give me the situation."
		"You called, $other. Report."
		"Lieutenant listening. Keep it concise."
		"Go ahead. What needs attention?"
	}
}
