// makron.chat
//
// Dialogue for Makron. Traits and models live in ../characters/makron.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Makron" {
	chat entergame {
		"The Makron has come. Kneel or be broken."
		"Your resistance ends here."
		"Begin. I will watch you fail."
		"I enter. Your choices are obedience and death."
		"The field has awaited its master."
		"You stand before the will of the Strogg."
		"Run now. It will make the hunt brief."
		"I have come to end this resistance."
	}
	chat levelstart {
		"$map belongs to the Strogg."
		"There is nowhere here I cannot reach."
		"Fight. Defiance changes nothing."
		"$map will carry the mark of my victory."
		"There is no refuge in $map."
		"Begin your final mistake."
		"Every path here returns you to me."
		"The Nexus demands an end. I will provide it."
	}
	chat kill {
		"$other, your defiance is ended."
		"Another body for the machine."
		"Flesh breaks so easily."
		"The $weapon was more than you deserved."
		"Rise again. I will kill you twice."
		"$other, resistance has a price."
		"The $weapon merely carried my will."
		"One less voice against the Strogg."
	}
	chat killGauntlet {
		"I needed no weapon to break $other."
		"Come closer. Learn who commands the Strogg."
		"Crushed by my own hand."
		"$other broke beneath my hand."
		"Weapons are wasted on the weak."
		"I reached you. That was enough."
		"Your armor did not matter at this distance."
		"Remember the hand that ended you."
	}
	chat killStreak {
		"Fall in whatever order you choose."
		"None of you can stop me."
		"Your numbers only amuse me."
		"Three failures. One ruler."
		"Keep rising. I have not tired of this."
		"Your resistance feeds my triumph."
		"The field empties at my command."
		"Every death confirms the order of things."
	}
	chat revenge {
		"$other, your insolence is answered."
		"You struck once. You will not again."
		"Authority restored."
		"$other, your punishment is complete."
		"You mistook one wound for permission."
		"The debt is paid in your blood."
		"I found you. Defiance ends."
		"No insult to the Makron goes unanswered."
	}
	chat death {
		"$other, I will tear that victory from you."
		"A wound, not a defeat."
		"Enjoy these seconds. They are all you have."
		"$other, this shell will rise stronger."
		"The $weapon bought you a moment."
		"You damaged the vessel, not the command."
		"I fall only to return."
		"This interruption will cost you everything."
	}
	chat deathAccident {
		"No enemy may claim this."
		"This shell failed me. It will be replaced."
		"An error. Do not mistake it for weakness."
		"The arena itself has made an enemy."
		"This failure belongs to the shell."
		"No hand defeated me."
		"The ground will not claim me twice."
		"A flawed step. The punishment is postponed."
	}
	chat itemDenied {
		"Return the $item, $other, or die holding it."
		"You steal from your ruler."
		"Take it. I will recover it from your corpse."
		"$other, the $item cannot save you."
		"Carry it to me. Spare me the search."
		"You clutch the $item like it grants authority."
		"Theft adds pain to your sentence."
		"Keep your prize. I will take the hand with it."
	}
	chat leadTaken {
		"Your place beneath me is restored."
		"The arena remembers its master."
		"I lead. You obey or perish."
		"The rightful order is restored."
		"I stand above you again."
		"The lead is not won. It is mine by right."
		"Now the score obeys."
		"All positions answer to the Makron."
	}
	chat leadLost {
		"You occupy my place, $other. Not for long."
		"Your lead is an insult I will correct."
		"Run while the numbers flatter you."
		"$other, your number has risen above your station."
		"The score lies. I will force it to confess."
		"A false leader invites execution."
		"Enjoy the height. The fall will be mine to deliver."
		"This disorder ends now."
	}
	chat matchWin {
		"The result was never in doubt."
		"Kneel. The victor stands before you."
		"This contest is over. My rule is not."
		"All resistance has reached its proper end."
		"The arena submits."
		"You fought only to prove my rule."
		"The Strogg require no second verdict."
		"Remember this defeat when I return."
	}
	chat matchLose {
		"Your victory condemns you. I will remember it."
		"You have won one moment. I command the next."
		"The Makron does not forget."
		"This field has delayed me, nothing more."
		"Celebrate. It will make your fear sweeter."
		"The result is an error awaiting correction."
		"Victory has made you visible."
		"You leave with a score. I leave with your measure."
	}
	chat farewell {
		"The Makron withdraws. Do not mistake it for mercy."
		"Live until I return."
		"This slaughter is concluded."
		"I depart because this field has nothing left to offer."
		"Keep breathing. I will correct that later."
		"My attention leaves you. My judgment does not."
		"The slaughter pauses."
		"You survive by my decision alone."
	}
	chat order {
		"You presume to command me, $other? Very well. This once."
		"The Makron obliges. Do not grow used to it."
		"A worthy instruction. It will be done."
		"I go. Mark how it is done."
		"Your request amuses me. I comply."
		"Command is mine to give, $other. Today I allow it."
		"As I would have chosen anyway."
		"It shall be done, and done better than you imagined."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Weakness calls out, $other. Overcome it or fall."
		"Preserve yourself if you still serve a purpose."
		"Find cover. I will not tolerate useless failure."
		"Your distress is noted. Your survival remains your burden."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"The contest was adequate, $other."
		"You provided resistance worthy of record."
		"This field has rendered its verdict."
		"The struggle ends. Its lesson remains."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"Defiance accepted, $other."
		"You have summoned your execution."
		"Stand before me and repeat that challenge."
		"Your threat has purchased my attention."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"You address the Makron, $other."
		"Your signal reaches its ruler."
		"Speak, and do not waste my attention."
		"Another voice enters my domain."
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"Your gratitude is proper."
		"Acknowledgment is the least you owe."
		"Keep your thanks. Obedience is sufficient."
		"Your tribute is heard, $other."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"At last, you recognize superiority."
		"Your judgment serves you, $other."
		"Praise changes nothing. The result stands."
		"Recognition is expected, not required."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"Regret does not erase defiance."
		"Your apology is beneath judgment."
		"The error remains, $other."
		"Begging will not alter your place."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Go, $other. Your reprieve is temporary."
		"Leave while permission remains."
		"Withdraw. I will remember your signal."
		"Your absence changes nothing."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Makron"

		"The Makron hears you."
		"You have my attention, $other. Briefly."
		"Speak before I silence you."
		"Your ruler is listening."
	}
}
