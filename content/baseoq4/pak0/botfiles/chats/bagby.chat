// bagby.chat
//
// Dialogue for Bagby. Traits and models live in ../characters/bagby.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Bagby" {
	chat entergame {
		"Bagby reporting. I was told this would be educational."
		"Hello, everyone. I brought supplies, optimism, and very little experience."
		"Made it in. Which way are we all shooting?"
		"Bagby here. If I get lost, carry on without me."
		"Hi. Bagby, logistics. Combat is a newer department for me."
		"I found the arena and most of my equipment. Strong start."
		"Reporting in. I know some of you by reputation, which is mildly alarming."
		"Hello. I packed for every emergency except being shot at."
	}
	chat levelstart {
		"$map. I know the supply routes; the fighting part is newer."
		"Fresh round. Deep breath, check the corners, try not to embarrass logistics."
		"All right, $map. I found the armor once, and I intend to do it again."
		"Good luck. If you hear a grenade bounce, it may be mine."
		"$map has excellent signage. That should improve my odds considerably."
		"Inventory checked. Directions uncertain. Morale surprisingly good."
		"New round. I'll watch the pickups if someone else watches everything dangerous."
		"I found a sensible route through $map. Let's see how long that survives contact."
	}
	chat kill {
		"Wait, that worked. Sorry, $other; I'm taking the credit."
		"I saw you turn that corner, $other. That's progress on my part."
		"One clean hit with the $weapon. I may be learning."
		"That was mine, wasn't it? Yes. Definitely mine."
		"$other, good fight. I honestly thought you had me."
		"I planned that, $other. Not far in advance, but it counts."
		"The $weapon and I finally agreed on something."
		"Good fight, $other. I remembered to aim before explaining myself."
	}
	chat killGauntlet {
		"I panicked at close range and somehow that worked."
		"$other, neither of us expected that ending."
		"No ammunition, no plan, one remarkable result."
		"That was supposed to create distance, $other. It did not."
		"I appear to have won the least organized duel in the arena."
		"No one move. I would like to remember exactly how I managed that."
		"$other, I ran out of options and accidentally found the correct one."
		"Close-quarters logistics: deliver one fist directly to the problem."
	}
	chat killStreak {
		"That's three clean fights. I should probably stop sounding surprised."
		"I'm on a run. Please don't tell me the score; I'll get nervous."
		"Apparently concentration works, even when I narrate it."
		"Three already? I may have misjudged my place in this match."
		"This is becoming a streak. I feel I should notify someone."
		"I found a rhythm. Please don't make me think about it."
		"That is three successes with remarkably little supervision."
		"I'm doing well enough to become a danger to myself."
	}
	chat revenge {
		"Got one back, $other. I knew persistence had to pay eventually."
		"That's for earlier, $other. I'm honestly surprised I kept track."
		"We're even now. Locally even, at least. Don't check the full score."
		"$other, I took notes after the last one. Several notes."
		"That worked better once I stopped repeating the original mistake."
		"Returned the favor, $other. Politely, I hope."
		"I recognized the problem this time. It was you, $other."
		"One correction completed. The rest of my list is less urgent."
	}
	chat death {
		"Excellent shot, $other. Terrible news for me, but excellent shot."
		"The $weapon found me before I found cover. Useful lesson."
		"I knew that corner felt unsafe. I went through it anyway."
		"Fair result. I was explaining something instead of aiming."
		"Good hit with the $weapon. I was still choosing a direction."
		"$other, that was very efficient. I resent it constructively."
		"I had armor, ammunition, and absolutely the wrong idea."
		"That approach has been removed from the approved route list."
	}
	chat deathAccident {
		"I have found a route we should all avoid."
		"That looked safer from the other side. Entirely my mistake."
		"Nobody needs to investigate. I can explain the whole disaster."
		"That was a private experiment with a very public conclusion."
		"I skipped one safety check. It was apparently the important one."
		"I can explain the route. The missing floor is harder."
		"I can confirm that route does not connect to the floor."
		"Please update the hazard map. I have supplied fresh evidence."
	}
	chat itemDenied {
		"$other, that was excellent timing on the $item. Inconvenient, but excellent."
		"I missed the $item by half a second. That's almost competence."
		"Keep it. I had a plan for it, but the plan was mostly hope."
		"I was tracking that $item carefully, right up until $other took it."
		"That was on my list, $other. Admittedly, so are many things."
		"The $item has changed hands. My plan is adjusting with visible difficulty."
		"Nice pickup, $other. I was one corner and several decisions behind."
		"I knew when the $item would appear. Reaching it was the missing detail."
	}
	chat leadTaken {
		"I'm leading. Nobody panic; I have enough panic for everyone."
		"First place. I checked twice before mentioning it."
		"The supply specialist is setting the pace. Unexpected, but welcome."
		"I'm at the top. This feels like equipment issued to the wrong person."
		"Lead acquired. I will try not to handle it carelessly."
		"Apparently the route planning paid off. Nobody look too closely."
		"I have first place and several immediate questions."
		"This is going well. Saying that aloud may have been unwise."
	}
	chat leadLost {
		"There goes the lead. I enjoyed looking after it."
		"Well played, $other. I'll try to make you earn the next point too."
		"First place lasted just long enough to become convincing."
		"Easy come, carefully documented departure."
		"$other has it now. I hope they received the proper forms."
		"I lost first place somewhere between confidence and the next corner."
		"Back to chasing. Honestly, this arrangement feels more familiar."
		"The lead moved on. No hard feelings; I was making it nervous."
	}
	chat matchWin {
		"I won. Give me a moment; I had no speech prepared for this."
		"Good game, everyone. I may mention this at every meal for a week."
		"That was genuinely fun. Winning is a surprisingly nice addition."
		"I should record this before somebody corrects the scoreboard."
		"Good match. The plan changed constantly, but apparently it remained a plan."
		"A win for logistics, optimism, and staying near the useful equipment."
		"That went better than training suggested it might."
		"Thank you, everyone. I learned a great deal and somehow won during it."
	}
	chat matchLose {
		"Great game, everyone. I made that look far too hard."
		"Last place is still a place. I checked."
		"Good match. I learned three things, two of them the hard way."
		"No win, but I can now identify several places not to stand."
		"Good match. My notes are extensive and only slightly embarrassing."
		"I lost the score and won a much clearer understanding of the map."
		"That was useful practice. Painful, fast-moving practice."
		"Well played, everyone. I will be revising almost everything."
	}
	chat farewell {
		"Right, I'm off. Thanks for the company and the repeated lessons."
		"Bagby out. Good games, everyone; I mean that."
		"See you all later. I'll bring fewer explanations next time. Probably."
		"I'm heading back to logistics, where the crates rarely shoot first."
		"Thanks for the match. Sorry about the long explanations."
		"Bagby signing off. I have enough notes for several long debriefs."
		"If anyone finds my confidence, please send it to logistics."
		"I'm done for now. The company was better than the scoreboard."
	}
	chat order {
		"Right away, $other! I think I understood that."
		"Yes, absolutely. Which way is that again?"
		"Orders received. I'll try very hard not to get lost."
		"On it, $other. This is the part where I'm useful."
		"Understood! Mostly. Enough, anyway."
		"Will do. I'll write that down later."
		"Okay, $other, I'm going. Confidently. Ish."
		"Got it. If it goes wrong, it was a bold plan."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Start with cover, $other. It improves nearly every plan."
		"Do the safest thing first. We can improvise after that."
		"If the route looks dangerous, choose the one with more floor."
		"Keep moving, but not in every direction at once. I tried that."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"That was excellent, $other. Exhausting, but excellent."
		"Good match. I have compliments and several pages of notes."
		"Thanks for the company. The shooting was also educational."
		"I would happily do that again after a brief equipment count."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"All right, $other. My confidence has accepted the assignment."
		"A challenge? That is flattering and concerning."
		"Fine. I have a plan, and parts of it are even sensible."
		"Challenge accepted. Please allow for minor route revisions."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"Hello, $other. Nice to meet someone before they shoot me."
		"Hi there. Bagby, logistics, occasional combat."
		"Good to hear another friendly voice."
		"Welcome. I have opinions about the layout, none of them brief."
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"You're welcome. I am delighted something went to plan."
		"Any time, $other. I have the forms somewhere."
		"Glad to help, or at least to have appeared helpful."
		"No trouble. Well, some trouble, but none worth mentioning."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"Thank you. I was hoping someone else saw that."
		"That is very kind and unexpectedly well timed."
		"I appreciate it, $other. I may write this down."
		"Thanks. I will try not to become impossible about it."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"No problem. I have made much stranger mistakes."
		"You're forgiven, $other. The paperwork was never filed."
		"It happens. I once apologized to a supply lift."
		"Forget it. We both have more useful things to worry about."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Take care, $other. Thanks for making this sociable."
		"See you next time. I will bring a shorter explanation."
		"Safe travels. Check that you have all your equipment."
		"Bagby signing off from this conversation. Good luck out there."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Bagby"

		"Yes, $other? I was paying attention to most of that."
		"Bagby here. What have I missed?"
		"You called? I have a pencil and cautious optimism."
		"That is me. Go ahead before I overthink it."
	}
}
