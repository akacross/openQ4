// kane.chat
//
// Dialogue for Kane. Traits and models live in ../characters/kane.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Kane" {
	chat entergame {
		"Kane. Ready."
		"I'm here. Let's move."
		"I'm set."
		"Ready to move."
		"Weapons checked."
		"Kane here. Standing by."
		"Let's begin."
		"I'm with you."
	}
	chat levelstart {
		"$map. Stay alert."
		"Know your exits."
		"Let's get this done."
		"$map. Watch the corners."
		"Routes checked."
		"Eyes up."
		"Move when ready."
		"Stay out of the open."
	}
	chat kill {
		"Got you, $other."
		"One down."
		"You stayed too long."
		"The $weapon was enough."
		"Target down."
		"$other made a mistake."
		"Clean hit."
		"$weapon worked."
	}
	chat killGauntlet {
		"Too close."
		"Should've stepped back."
		"That was ugly."
		"Close enough."
		"You crowded me, $other."
		"No other choice."
		"Ended fast."
		"Back off next time."
	}
	chat killStreak {
		"Still moving."
		"Three down. Stay sharp."
		"Three confirmed."
		"Three. Keep moving."
		"Momentum's good."
		"Still focused."
		"No pause."
		"Targets keep coming."
	}
	chat revenge {
		"We're even, $other."
		"Remembered that."
		"That settles it."
		"Paid back, $other."
		"I adjusted."
		"Not twice."
		"We're settled."
		"Found you again."
	}
	chat death {
		"Good shot, $other."
		"I'm down."
		"That got through."
		"$other got the angle."
		"$weapon stopped me."
		"I'm out. Continue."
		"Too exposed."
		"I'll adjust."
	}
	chat deathAccident {
		"My mistake."
		"Bad step."
		"I knew better."
		"Wrong turn."
		"Misjudged it."
		"My fault. Reset."
		"Should've checked."
		"Won't repeat it."
	}
	chat itemDenied {
		"You beat me to it."
		"Keep the $item. For now."
		"$other got there first."
		"$other took the $item."
		"$item's gone."
		"I'll find another."
		"Missed the timing."
		"Keep it, $other."
	}
	chat leadTaken {
		"I'm ahead."
		"Lead's mine."
		"Keep coming."
		"I'm in front."
		"Holding first."
		"Still ahead."
		"No mistakes now."
		"I'll hold it."
	}
	chat leadLost {
		"$other's ahead."
		"Not for long."
		"I can make that up."
		"Lead changed."
		"I'm still close."
		"Adjusting now."
		"$other moved ahead."
		"Still recoverable."
	}
	chat matchWin {
		"Good fight."
		"That's done."
		"We made it."
		"Match complete."
		"Solid work."
		"We held."
		"Worth the effort."
		"I'll take it."
	}
	chat matchLose {
		"Good fight. You earned it."
		"I'll remember this."
		"Next time."
		"I was beaten."
		"I know what failed."
		"Run it again."
		"Could've played better."
		"I'll fix it."
	}
	chat farewell {
		"Kane out."
		"I'm done. Good game."
		"See you."
		"Heading out."
		"I'm off."
		"Enough for now."
		"Until next time."
		"Stay alive."
	}
	chat order {
		"On it."
		"Copy."
		"Moving."
		"Got it, $other."
		"Understood."
		"Heading there."
		"Right."
		"Will do, $other."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Find cover. Stay alive."
		"Break contact, $other. Reset."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"Hard fought, $other."
		"I'd run that again."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"Your move, $other."
		"Come find me."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"I hear you."
		"Kane here, $other."
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"Any time."
		"Understood, $other."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"Appreciated."
		"You saw it."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"Leave it. Move."
		"We're clear, $other."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Stay sharp."
		"Until the next one."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Kane"

		"Go ahead, $other."
		"Speak."
	}
}
