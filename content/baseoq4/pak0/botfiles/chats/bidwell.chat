// bidwell.chat
//
// Dialogue for Bidwell. Traits and models live in ../characters/bidwell.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Bidwell" {
	chat entergame {
		"Bidwell's here. Form up and move."
		"All right, Marines. Get your heads in it."
		"Quit sightseeing. We've got a match to win."
		"Check your weapons and step off."
		"Bidwell reporting. Fall in."
		"Eyes front, weapons ready."
		"Let's see whether any of you learned something."
		"Move with purpose or get out of the way."
	}
	chat levelstart {
		"$map. Learn the lanes or die in them."
		"Spread out. I don't want a damn firing squad."
		"Armor first. Don't hand them an easy kill."
		"$map. Take ground and hold it."
		"Check corners. I won't repeat myself."
		"Move fast, shoot straight, stay alive."
		"Watch the exits and quit bunching up."
		"First contact. Make it count."
	}
	chat kill {
		"Down you go, $other. Should've kept moving."
		"That's what training buys you."
		"You walked into that $weapon like a damn recruit."
		"One down. Find me another."
		"That's another lesson, $other."
		"Good effect with the $weapon. Move."
		"You hesitated. I didn't."
		"Target down. Keep the line moving."
	}
	chat killGauntlet {
		"That was embarrassing, $other."
		"Too close, recruit. Way too close."
		"Next time, bring a weapon."
		"You let me reach you, $other. Fix that."
		"No ammunition needed for that lesson."
		"Close-range failure, recruit."
		"That should hurt your pride."
		"Stand farther back next time."
	}
	chat killStreak {
		"Three down. Keep 'em coming."
		"They keep lining up. I'm not complaining."
		"Stay sharp. A streak ends when you get stupid."
		"Three targets, three corrections."
		"That's momentum. Use it."
		"Don't admire the score. Keep working."
		"Three down and I'm still moving."
		"This is what prepared looks like."
	}
	chat revenge {
		"Debt paid, $other. Move along."
		"That's for the last one."
		"Try it again. I damn well dare you."
		"Here's your correction, $other."
		"You got one chance. You wasted it."
		"That mistake's been addressed."
		"Score's even. Standards aren't."
		"Lesson repeated, $other."
	}
	chat death {
		"$other got me. Don't stand there gawking."
		"Good shot. Now survive the return."
		"That $weapon found me. Once."
		"Dammit. Back in the fight."
		"I overcommitted. Correcting."
		"$other earned that one. Don't expect another."
		"The $weapon caught me out of position."
		"Down, not finished."
	}
	chat deathAccident {
		"That was undisciplined."
		"My mistake. Won't happen twice."
		"Nobody saw that. Understood?"
		"Careless footing. Unacceptable."
		"I rushed the route. My fault."
		"Bad judgment. Logged and corrected."
		"That one's on me. Keep moving."
		"Stupid mistake. It ends here."
	}
	chat itemDenied {
		"$other took the $item. Take it back."
		"You beat me to it. Enjoy the head start."
		"Next $item is mine. Clear?"
		"$other has the $item. Deny the follow-up."
		"Lost the pickup. Win the fight instead."
		"You got the $item. Now prove it matters."
		"Too slow. Correcting the route."
		"Equipment's gone. Mission isn't."
	}
	chat leadTaken {
		"I've got the lead. Keep up."
		"Front of the board. That's the standard."
		"Lead secured. No celebrating yet."
		"That's first place. Hold the damn line."
		"Lead's mine. Pressure stays on."
		"We earned the front. Defend it."
		"Good position. Don't waste it."
		"Now make them fight for every point."
	}
	chat leadLost {
		"$other took the lead. Fixing that now."
		"We got sloppy. Tighten it up."
		"Enjoy it, $other. You won't hold it."
		"Lead's gone. Earn it back."
		"$other moved faster. Move faster still."
		"Nobody panic. Just execute."
		"First place is a position, not a birthright."
		"Reset and hit harder."
	}
	chat matchWin {
		"That's the result I expect. Good work."
		"Well fought, Marines. Dismissed."
		"Discipline wins matches. Remember that."
		"Standards met. Barely."
		"Good result. Remember how you earned it."
		"That's what disciplined fire looks like."
		"Take the win. Don't get soft."
		"Solid work. Be ready to do it again."
	}
	chat matchLose {
		"Sloppy from start to finish. We correct it."
		"The winner earned it. The rest of us need work."
		"Loss is over. Learn and move."
		"We were beaten because we made it easy."
		"No excuses. Review every bad decision."
		"That result was unacceptable. Fix the cause."
		"Learn it now or repeat it later."
		"Get angry after the debrief, not before."
	}
	chat farewell {
		"Bidwell out. Keep your damn guard up."
		"Training's over. Dismissed."
		"Good work. Don't let it go to your heads."
		"Bidwell signing off. Stay ready."
		"You're dismissed. Don't get comfortable."
		"Enough for now. Maintain your gear."
		"Good fighting. Keep training."
		"Sergeant's leaving. Standards remain."
	}
	chat order {
		"Heard, $other. Moving."
		"Copy. Nobody slacks off while I'm doing it."
		"Understood. Consider it done."
		"On my way. Keep the line tight."
		"Roger that, $other. Executing."
		"It'll get done right. I'll see to it."
		"Acknowledged. Eyes up, Marines."
		"Moving now. Don't make me come back for you."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Get behind cover, $other. Then assess."
		"Stop feeding them a target. Break contact and reset."
		"Stay alive first. Pride can wait."
		"Use the nearest safe route and quit hesitating."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"Solid match, $other. You met the standard."
		"Well fought. Remember what worked."
		"Good execution from start to finish."
		"That was worth the effort. Be ready to repeat it."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"You want a fight, $other? Square up."
		"Fine. Show me what your training bought."
		"Challenge heard. Now prove you meant it."
		"Step forward and earn that confidence."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"Report in, $other."
		"Good, you're here. Get ready."
		"Bidwell copies. Stay alert."
		"Save the ceremony. We have work."
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"Do the job right and we're even."
		"Acknowledged. Keep moving."
		"You're welcome. Don't waste the advantage."
		"No thanks needed. Maintain the standard."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"Appreciated, $other. Now watch the next lane."
		"Good eye. Now meet the same standard."
		"That's enough praise. Stay focused."
		"Good assessment. Keep your guard up."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"Own it, correct it, move on."
		"Apology accepted. Do not repeat the mistake."
		"Save the guilt. Fix the problem."
		"Understood, $other. Show me the correction."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Dismissed, $other. Stay ready."
		"Move out. Keep your equipment in order."
		"Good work. Do not get comfortable."
		"That's all. Maintain discipline out there."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Bidwell"

		"Bidwell here. State your business."
		"I heard you, $other. Speak up."
		"You called the sergeant. What do you need?"
		"Make it quick. I'm listening."
	}
}
