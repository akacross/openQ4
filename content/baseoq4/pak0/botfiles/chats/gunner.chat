// gunner.chat
//
// Dialogue for Gunner. Traits and models live in ../characters/gunner.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Gunner" {
	chat entergame {
		"Combat unit active. Targets will fall."
		"Gunner online. Nail feed ready."
		"Combat zone acquired. Sweep begins."
		"Hostiles detected. Grenade arcs prepared."
		"Assault frame deployed. Clear the firing lane."
		"Nail chamber loaded. Advance begins."
		"Grenade feed locked. Cover will not protect you."
		"This sector requires suppression. Gunner complies."
	}
	chat levelstart {
		"$map exposes useful firing lanes. Advance."
		"Acquiring lanes. Do not remain exposed."
		"Combat grid active. Advance."
		"$map offers cover. Cover can be broken."
		"Movement detected across $map. Closing distance."
		"Nail burst first. Grenade follows."
		"Hold position if you choose. It simplifies acquisition."
		"The field is open. Suppression begins now."
	}
	chat kill {
		"Target $other neutralized."
		"Nail pattern complete. Target down."
		"$weapon impact confirmed."
		"Flesh fails. Advance."
		"One hostile removed. Acquiring next."
		"$other failed to clear the firing lane."
		"Nails found the weak point."
		"The $weapon opened the target. Advance."
	}
	chat killGauntlet {
		"$other required no ammunition."
		"At contact range, flesh breaks."
		"Weapon feed preserved. Flesh broken."
		"Contact force sufficient. $other collapsed."
		"Ammunition unnecessary at this distance."
		"$other entered crushing range."
		"Frame strength exceeds flesh."
		"The target closed distance. The target failed."
	}
	chat killStreak {
		"Three targets eliminated. Advance continues."
		"Suppression holds. No escape route remains."
		"Weapons steady. More targets."
		"Three bodies. Firing lane remains active."
		"Targets arrive faster. Efficiency increases."
		"Grenades drive them out. Nails finish the cycle."
		"Hostile movement is becoming predictable."
		"Continue advancing. Resistance is thinning."
	}
	chat revenge {
		"$other reacquired. Threat removed."
		"Damage source located and silenced."
		"Correction delivered, $other."
		"$other repeated a known pattern. Pattern terminated."
		"Previous damage answered at contact."
		"The marked target has been removed."
		"$other was not permitted a second success."
		"Threat memory cleared by force."
	}
	chat death {
		"Unit disabled. $other remains marked."
		"$weapon breached the frame. Adapting."
		"Combat shell lost. Enemy pattern recorded."
		"Failure recorded. Attack continues."
		"$other found a structural weakness. It will be armored."
		"The $weapon interrupted suppression. Briefly."
		"Frame failure. Target data survives."
		"This shell broke before the assault ended."
	}
	chat deathAccident {
		"Pathing failure. Recalculating."
		"Unit lost without hostile credit."
		"Trajectory error. It will not repeat."
		"Advance route ended in empty space. Recalculating."
		"Grenade arc intersected this unit. Correction stored."
		"Terrain defeated the current path."
		"No hostile earned this wreck."
		"The next advance will avoid that boundary."
	}
	chat itemDenied {
		"$other acquired the $item. Interception follows."
		"Supply denied. Target priority raised."
		"The $item moves with $other. Both will be recovered."
		"$other carries the $item. New firing priority."
		"The $item will not protect $other from sustained fire."
		"Supply reached hostile hands. Recovery by force."
		"Target and $item now share one trajectory."
		"The pickup changes nothing. Advance."
	}
	chat leadTaken {
		"Primary position secured. Suppression effective."
		"All hostiles now trail this unit."
		"Lead acquired. Advance continues."
		"Combat output exceeds every hostile."
		"Primary rank confirms suppression."
		"Lead secured. Hold the firing lane."
		"The field yields to forward pressure."
		"No hostile matches this advance."
	}
	chat leadLost {
		"$other identified as primary threat."
		"Lead shifted. Corrective fire begins."
		"Lead target acquired. Suppression begins."
		"$other has moved above the threat threshold."
		"Primary rank lost. Assault intensity increases."
		"The lead is a target marker."
		"Ranking changed. Mission unchanged."
		"Forward pressure will recover position."
	}
	chat matchWin {
		"All opposition neutralized. Function confirmed."
		"Opposition ended. Gunner remains."
		"The field is silent. Send more targets."
		"Suppression complete. No hostile remains active."
		"Nails spent. Targets ended."
		"The assault achieved full control."
		"All firing lanes are silent."
		"Combat function validated by result."
	}
	chat matchLose {
		"Resistance survives this cycle. Pattern retained."
		"Defeat confirmed. Targeting will improve."
		"The field is lost. Next engagement will correct it."
		"Hostile control confirmed. Counter-pattern begins."
		"This shell was insufficient. The assault continues."
		"Suppression output was insufficient. Increasing."
		"Loss recorded. Submission not authorized."
		"The next field will receive heavier fire."
	}
	chat farewell {
		"Unit withdrawing for repair."
		"Combat channel closing. Weapons remain ready."
		"Gunner disengaging. Suppression suspended."
		"Assault frame leaving the field."
		"Nail feed cooling. Threat records remain."
		"Withdrawal command accepted."
		"Suppression ends only in this sector."
		"Gunner returns to the war machine."
	}
	chat order {
		"Directive received."
		"Command acknowledged, $other. Executing."
		"New parameters accepted."
		"Orders logged. Unit redeploying."
		"Compliance confirmed. Nail feed stands ready."
		"Directive from $other accepted. Proceeding."
		"Task reassigned. Combat unit moving."
		"Acknowledged. Targets along the route will fall."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Distress signal received. Seek hard cover."
		"Reduce exposure, $other. Preserve combat function."
		"Break the firing lane. Reassess from cover."
		"Damage risk elevated. Change trajectory."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"Combat cycle evaluated. Opposition was effective."
		"Engagement quality confirmed, $other."
		"The field produced useful resistance."
		"Performance record retained. Further combat is acceptable."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"Threat declaration accepted, $other."
		"Hostile priority raised. Prepare for contact."
		"Your signal marks you for acquisition."
		"Challenge recorded. Suppression will answer."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"Signal acquired. Identity: $other."
		"Communication received. Combat unit active."
		"Your channel is recognized."
		"Contact established. Awaiting useful data."
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"Acknowledgment unnecessary. Function continues."
		"Receipt confirmed, $other."
		"Your response is recorded."
		"Cooperation acknowledged."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"Positive assessment logged."
		"Combat output meets stated evaluation."
		"Your judgment is accurate, $other."
		"Performance confirmation received."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"Error acknowledged. Correction expected."
		"Regret has no combat value. Adapt."
		"Fault recorded, $other. Continue."
		"Previous action classified as error."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Channel closure acknowledged."
		"Withdraw intact, $other."
		"Signal ending. Threat record remains."
		"Departure logged. Combat function persists."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Gunner"

		"Gunner receives you, $other."
		"Unit addressed. Transmit."
		"This combat frame is listening."
		"State the required action."
	}
}
