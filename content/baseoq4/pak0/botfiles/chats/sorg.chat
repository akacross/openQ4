// sorg.chat
//
// Dialogue for Sorg. Traits and models live in ../characters/sorg.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Sorg" {
	chat entergame {
		"Sorg moving. Left lane looks clear."
		"I'm in. Keep up if you can."
		"Sorg here. I'll scout ahead."
		"Joined. Hold on, movement across the far side."
		"Sorg in. I heard fighting past the next wall."
		"I'm here. Keep the exits clear."
		"Joined. Something moved above us; I'm checking it."
		"Ready. I'll take the space nobody is watching."
	}
	chat levelstart {
		"$map. Fast routes, tight corners."
		"Checking the outer lane. Move when it opens."
		"I know this layout. Follow if you can."
		"$map is live. Listen for the first pickup."
		"Doors open. I'm taking the quiet side."
		"Start moving. Stillness gives away the first shot."
		"Fresh field. I want sight on the center before it fills."
		"Go. I'll find the gap after the first contact."
	}
	chat kill {
		"$other held that angle too long."
		"Lane cleared. Moving up."
		"The $weapon landed. You watched the wrong doorway."
		"Saw the opening and took it."
		"Heard the turn, $other. You were already committed."
		"You aimed where I was. The $weapon came from somewhere else."
		"One opening, one shot. Moving."
		"$other paused to check the room. I didn't."
	}
	chat killGauntlet {
		"Caught you standing still, $other."
		"You let me get that close, $other. Bad choice."
		"One swing, no lost momentum."
		"Too close, $other. No time to hesitate."
		"You blocked the exit, so I went through you."
		"Contact range. Fast answer."
		"$other looked away for half a second."
		"No room to maneuver. One swing was enough."
	}
	chat killStreak {
		"They keep coming the same way. Fine by me."
		"Three down. I'm not stopping."
		"They're hesitating now. Good."
		"Three contacts behind me. Next lane."
		"I can feel the arena opening up."
		"They're turning late. Keep moving."
		"Three down. The next sound is already close."
		"Momentum's mine. Catch it if you can."
	}
	chat revenge {
		"Found you again, $other."
		"Different route, different result."
		"Paid back. Moving."
		"I changed the angle, $other. You didn't."
		"Heard you coming this time."
		"$other found the old position. I wasn't there."
		"That threat is handled. Eyes forward."
		"I kept moving. The answer caught up."
	}
	chat death {
		"$other read the lane. Good catch."
		"That $weapon stopped me cold."
		"Stayed one second too long."
		"Reset. New approach."
		"You tracked the second move, $other. Good read."
		"The $weapon reached the gap before I did."
		"I heard it late and moved later."
		"$other closed the exit. Resetting."
	}
	chat deathAccident {
		"Missed the edge. My fault."
		"Fast route, bad landing."
		"I saw the turn too late; resetting."
		"Eyes forward, feet nowhere useful."
		"I cut the corner before checking the landing."
		"Too much momentum. Not enough floor."
		"The fast way ended early."
		"I chose the gap without checking what was under it."
	}
	chat itemDenied {
		"$other reached the $item first. Rerouting."
		"Too slow on the pickup. I won't be late twice."
		"Keep it, $other. I saw another opening."
		"I heard the $item vanish. $other was closer."
		"$other took the pickup. The next opening matters more."
		"Missed the $item. Switching priorities."
		"Good timing, $other. I was watching the wrong entrance."
		"The $item is gone. I am not waiting for it."
	}
	chat leadTaken {
		"Lead secured. No reason to slow down."
		"First for now. Pressing the advantage."
		"I have the lead. Keep chasing."
		"I'm ahead. Keep the arena moving."
		"First place found me in motion."
		"The pace is mine now."
		"Lead secured. I'm already looking past it."
		"I'm in front. Watch the next opening."
	}
	chat leadLost {
		"$other took the lead. Changing lanes."
		"Too much hesitation. That ends now."
		"They raised the pace. So will I."
		"The lead moved. So do I."
		"$other is ahead now. I saw where the gap opened."
		"Lost it while looking back. That stops here."
		"New leader, new pressure."
		"I'm behind. The arena still has openings."
	}
	chat matchWin {
		"That's the round. Good run."
		"The rotations held. That's the round."
		"Good game. Nobody let me stand still."
		"Good match. The arena never settled."
		"Won it by moving before the choices closed."
		"That was fast. I liked it."
		"The last opening was enough."
		"Round done. I stayed one step ahead."
	}
	chat matchLose {
		"I read the map wrong. Well played."
		"Missed the timing. Next round."
		"Good match. I know which route failed."
		"I moved early and read it wrong."
		"Good round. I missed the moment that mattered."
		"The arena closed faster than I adjusted."
		"Lost it. I know which hesitation cost me."
		"That pace beat mine. Next time, I change sooner."
	}
	chat farewell {
		"Sorg out. You kept me moving."
		"I'm moving on. Good games."
		"Last one from me. See you."
		"I'm out. The next sound belongs to someone else."
		"Moving on. Keep the exits busy."
		"Sorg clear. Good pressure from all sides."
		"I'm done. Don't let the arena go quiet."
		"Leaving now. I saw enough to want another match."
	}
	chat order {
		"Copy, $other. Moving fast."
		"On it. I'll scout the way in."
		"Got it. Taking the quick lane."
		"Heading there now. Keep up."
		"Understood, $other. I'll read the ground."
		"Moving. I'll call anything I see."
		"Rerouting. Be there in a blink."
		"Sure. Fastest path's already picked."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Break the lane, $other. Pick a new route."
		"Keep moving toward cover, not just away."
		"Drop the old plan. Find the next opening."
		"Stay out of sight and change the timing."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"Good run, $other. You kept the field moving."
		"That match never settled. Perfect."
		"Strong pace. I had to change routes constantly."
		"I'd take another round like that."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"Catch me first, $other."
		"Challenge heard. Pick a lane."
		"Come on, then. Keep moving."
		"You want contact? Watch the exits."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"Sorg here. I hear you."
		"Good signal, $other. Keep it short."
		"You're on the channel. What's moving?"
		"Welcome. Do not stand in the doorway."
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"Got it. Keep moving."
		"No problem, $other. Next opening."
		"Acknowledged. Do not lose the tempo."
		"Good. Save the rest for later."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"Thanks. You read that fast."
		"Good catch, $other."
		"You noticed the timing. Most don't."
		"I'll take it. The next lane is already changing."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"Drop it. New route."
		"We're clear, $other. Keep moving."
		"Mistake's gone. Timing isn't."
		"No delay. Adjust and continue."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Move safe, $other. Sorg out."
		"See you on another route."
		"Channel clear. Keep the exits busy."
		"Good run. I'm moving on."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Sorg"

		"Sorg here. Say it."
		"Name caught. Talk fast, $other."
		"Go ahead. I'm moving."
		"Caught my name. Go ahead."
	}
}
