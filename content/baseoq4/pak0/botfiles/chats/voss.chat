// voss.chat
//
// Dialogue for Voss. Traits and models live in ../characters/voss.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Voss" {
	chat entergame {
		"Voss here. Watch your lanes."
		"Get your heads in the match."
		"Get set. Nobody runs off alone."
		"Voss reporting. Keep comms clear and choices simple."
		"I'm in. Cover each other and don't force the fight."
		"Check your exits before the shooting starts."
		"Ready up. Good judgment keeps you in the match."
		"Let's work. Call the threat, then deal with it."
	}
	chat levelstart {
		"$map. Check the routes before you commit."
		"Hold good ground. Don't chase."
		"Clock's running. Work the lanes."
		"$map has long lanes and bad exits. Use both carefully."
		"Find cover first. The first kill isn't worth a bad position."
		"Know where you're falling back before you push."
		"Watch the center. It pulls people into bad fights."
		"Set your route now. Change it when the facts change."
	}
	chat kill {
		"$other overcommitted. Don't do the same."
		"I had the angle."
		"That $weapon finished the job."
		"One down. Eyes on the next."
		"Threat down. Don't crowd the position."
		"$other made the first mistake. I finished it."
		"Good effect with the $weapon. Move before they answer."
		"That's one problem solved. Keep looking."
	}
	chat killGauntlet {
		"You came in too close, $other."
		"No room to maneuver. That decided it."
		"Not the cleanest option. It worked."
		"$other forced close quarters. Bad choice."
		"Too close for good tactics. Still close enough."
		"No clean shot, so I used what I had."
		"That got ugly. Reset your distance."
		"Next time, we keep a lane between us."
	}
	chat killStreak {
		"I've got their timing. Keep pressure."
		"Three down. No heroics."
		"They're reacting now. I'll set the pace."
		"Three confirmed. Tighten up; they'll change tactics."
		"The pressure's working. Don't overextend it."
		"Good sequence. Now expect the counter."
		"I'm reading them well. Stay unpredictable."
		"Momentum helps. Discipline keeps it."
	}
	chat revenge {
		"That's settled, $other. Moving on."
		"First contact gave me what I needed."
		"We're even. Stay focused."
		"$other showed the gap. I closed it."
		"Correction made. No reason to dwell on it."
		"I changed the approach. That was enough."
		"That answers the last engagement."
		"Score settled. Priorities unchanged."
	}
	chat death {
		"$other got through. Watch that route."
		"Good shot. I gave you the angle."
		"The $weapon found a gap."
		"I'm down. The lane is still dangerous."
		"$other made the better decision."
		"That $weapon punished a bad position."
		"I stayed too long. Don't repeat it."
		"Clean hit. Reset and move."
	}
	chat deathAccident {
		"My fault. I rushed it."
		"Bad call. I won't repeat it."
		"That was avoidable. Remember why."
		"I ignored my own exit plan."
		"That's what unnecessary risk buys."
		"Poor judgment. Clear consequence."
		"No excuse. I had time to choose better."
		"Remember that route. Then avoid what I just did."
	}
	chat itemDenied {
		"$other has the $item. Don't contest blindly."
		"Lost the $item. Take the better position."
		"You got there first. I won't chase."
		"$other secured the $item. Adjust before engaging."
		"Resource lost. Don't compound it with a bad fight."
		"The $item changes the next engagement. Plan for it."
		"I was late. Better to concede it than die reaching."
		"Let the pickup go. Take control of the route."
	}
	chat leadTaken {
		"I've got the lead. Stay disciplined."
		"We're in front. Keep the pressure steady."
		"Ahead now. No heroics."
		"Lead secured. Build on it; don't gamble it."
		"We're ahead because the choices were sound."
		"First place is a position, not permission."
		"Good. Now make them take risks."
		"$other, you made me earn the top spot."
	}
	chat leadLost {
		"$other's ahead. Change the approach."
		"Lead's gone. Priorities stay the same."
		"Don't chase the score. Make the next shot count."
		"$other has the advantage. Deny the easy fights."
		"We gave up the lead one decision at a time."
		"Change pace, not principles."
		"The score moved. We move smarter."
		"Lead's gone. Don't do anything stupid to get it back."
	}
	chat matchWin {
		"Good fight. The plan held under pressure."
		"Won the match. That's enough."
		"Solid work. No wasted risks."
		"Good result. The restraint mattered."
		"We controlled the dangerous moments."
		"That's a win built on sound decisions."
		"Strong finish. Remember what made it work."
		"Well fought. There were no easy decisions."
	}
	chat matchLose {
		"The win was earned. We gave away too much ground."
		"We lost control early. That's on me."
		"Good fight. Next time, fewer mistakes."
		"We forced fights that didn't need forcing."
		"The loss is clear. So is the correction."
		"We gave away too many safe exits."
		"Take the lesson and leave the frustration."
		"Good opposition exposed bad discipline."
	}
	chat farewell {
		"Voss out. Keep your heads down."
		"I'm done. Good work."
		"That's all for me. Stay sharp."
		"Voss signing off. Keep your exits clear."
		"I'm leaving. Don't let the match rush your judgment."
		"Keep the discipline when I'm gone."
		"That's my last call. Watch each other's blind side."
		"Until next time. Make the safe choice before the brave one."
	}
	chat order {
		"Copy, $other. Keep it simple."
		"Understood. Moving with purpose."
		"On it. Watch my lane while I go."
		"Roger. Stay together on this one."
		"Good order, $other. Executing."
		"Moving now. Comms stay clear."
		"Acknowledged. Stay disciplined."
		"Will do. Hold the formation."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Get to cover, $other. Do not compound the problem."
		"Break contact and choose a safer route."
		"Secure a way out before committing again."
		"Slow down. One sound decision gets you back in it."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"Good match, $other. No one got an easy decision."
		"Strong contest. Discipline made the difference."
		"Well fought. Everyone had to make real choices."
		"That result was earned on both sides."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"I hear you, $other. No heroics."
		"Challenge accepted. Choose your ground carefully."
		"If you want the fight, make the decision count."
		"Come prepared. I will not chase theatrics."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"Voss here. Good to hear you, $other."
		"You're on the channel. Keep your head in the match."
		"Welcome. Check your exits."
		"I hear you. Stay sharp."
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"Acknowledged, $other."
		"You're welcome. Use the opportunity well."
		"No debt. Make the next choice count."
		"Good. Keep the focus where it belongs."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"Appreciated. The position made it possible."
		"Thank you, $other. It was the right call."
		"Noted. Save some respect for the next fight."
		"Good assessment. Do not let it distract you."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"Accepted. Fix the decision, not the story."
		"Leave it there, $other. Reset."
		"Own the mistake and choose better next time."
		"Understood. No reason to lose focus over it."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Voss acknowledges. Leave safely."
		"Take care, $other. Keep your judgment sharp."
		"Good work. We'll see you next match."
		"You're clear to go. Watch your blind side."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Voss"

		"Voss listening. What's the situation?"
		"You're heard, $other. State it clearly."
		"You have my attention. Keep it clear."
		"State what matters."
	}
}
