// morris.chat
//
// Dialogue for Morris. Traits and models live in ../characters/morris.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Morris" {
	chat entergame {
		"Morris is on the air. Try not to embarrass yourselves."
		"All right, who's ready to make me look good?"
		"Comms are clear, weapons are hot. Let's make some trouble."
		"Morris here. Yes, the channel just got better."
		"I'm in. Somebody give me something worth reporting."
		"All stations, prepare for loud opinions and accurate fire."
		"Made it. Now the match can stop waiting."
		"Let's get moving before somebody starts a briefing."
	}
	chat levelstart {
		"$map, huh? Fine. I know where the bodies pile up."
		"Check your weapons and your excuses. We're starting."
		"Spread out. I can't mock all of you at once."
		"$map is live. Keep moving and call what you see."
		"I know this place. Trouble's two corners away."
		"Quick check: ammo, exits, people about to regret this."
		"Pick a route and commit. I'll cover the interesting one."
		"Open channel, open season. Let's work."
	}
	chat kill {
		"There you go, $other. That's what standing still gets you."
		"I saw that coming, and I'm not even the clever one."
		"$weapon says you're done. Who am I to argue?"
		"That plan fell apart quickly, didn't it?"
		"Contact finished. Commentary continues."
		"$other, I warned you with all that shooting."
		"Clean work with the $weapon. Mostly mine."
		"And that's why you listen when Morris calls a lane."
	}
	chat killGauntlet {
		"I crossed the whole damn room for that, $other."
		"No ammo, no problem. A little dignity would've helped."
		"Up close and embarrassing. My favorite kind of report."
		"$other, that was way too much effort for one report."
		"Hand-to-hand. Guess the training wasn't decorative."
		"I hope nobody important was watching that."
		"That fight needed less distance and more bad judgment."
		"Comms note: personal space remains a tactical asset."
	}
	chat killStreak {
		"That's three? Somebody start taking notes."
		"I'm doing all the work and the commentary."
		"Keep coming. This is damn near relaxing."
		"Three calls, three answers. Channel's still clear."
		"I'm on a run. Try not to make it look easy."
		"That's a streak, people. Yes, I'm taking credit."
		"I talk fast because the kills keep interrupting."
		"Keep the route open. I'm not done."
	}
	chat revenge {
		"That's the return call, $other."
		"Payback delivered. No signature required."
		"You got one. I got annoyed."
		"$other, your victory had a very short broadcast window."
		"Message received, corrected, and returned."
		"I don't hold grudges. I schedule follow-ups."
		"That's what I call professional satisfaction."
		"Next time, don't give me a second call."
	}
	chat death {
		"Well, shit. Nice shot, $other."
		"Yeah, yeah, I walked into that one."
		"$weapon? That's just rude."
		"Damn it. Mark that lane before someone else repeats me."
		"Okay, $other, that was annoyingly professional."
		"I had a comment ready. The $weapon interrupted it."
		"I'm down. Keep the channel useful."
		"That was clean. I hate clean when it happens to me."
	}
	chat deathAccident {
		"Nobody report that. Especially not Strauss."
		"That was tactical... ah, hell, I screwed up."
		"I'd explain, but the explanation is embarrassing."
		"I just lost an argument with the floor."
		"Strike that maneuver from the training material."
		"Comms correction: I meant to say 'don't do that.'"
		"Hell of a way to prove gravity still works."
		"No hostile action required. That's the bad news."
	}
	chat itemDenied {
		"You stole my $item? Bold move, $other."
		"Hey, I had plans for that."
		"Fine, take it. I'll loot it off you later."
		"$other took the $item. Route around and keep working."
		"That $item had my name on it in very small print."
		"All right, new plan: take it back after the shooting."
		"I called the pickup. Apparently nobody was listening."
		"You got the gear. I've still got the better mouth."
	}
	chat leadTaken {
		"Your new leader is handsome, competent, and very modest."
		"First place. Comms confirms what we all suspected."
		"I'm ahead. Try to sound surprised."
		"Lead secured. Keep the lanes noisy."
		"I'm on top. This is excellent material."
		"First place, and I didn't even have to edit the report."
		"We're ahead. Don't make me turn responsible."
		"$other, you can have the channel when you catch up."
	}
	chat leadLost {
		"$other took the lead. All right, now I'm interested."
		"Enjoy it while you can. I'm fixing this."
		"Lead's gone. Damn it, stop celebrating."
		"Score update: bad. Tactical update: fixable."
		"$other, congratulations on becoming my next problem."
		"I dropped the lead. Keep moving; I'll get it back."
		"That's a change in standings, not command."
		"All right, less commentary, more correction."
	}
	chat matchWin {
		"That's the match. Keep the thank-you speeches short."
		"Good game, people. Hell of a mess."
		"All jokes aside, you made me work for that."
		"Channel clear, scoreboard settled. Nice work."
		"That's how you finish a match: loud and on time."
		"Good fight. Even the comms had to keep up."
		"Result confirmed: I'm excellent, opposition respectable."
		"We got it done. That's the part worth remembering."
	}
	chat matchLose {
		"All right, that was damn good. Rematch later."
		"I've got excuses, but none of them are convincing."
		"Good game. Next one, I talk less and shoot more."
		"No clever line for that one. We got beaten."
		"I talked through the problem and still missed the answer."
		"Solid work out there. I hate admitting it."
		"We'll call that a rough transmission and try again."
		"Match over. Pride damaged, equipment functional."
	}
	chat farewell {
		"Morris signing off. Try to survive without the commentary."
		"Good games. I'm getting out of here."
		"Comms going dark. See you next round."
		"Morris out. Keep the channel clear-ish."
		"I'm done talking. Enjoy the historic occasion."
		"That's my last call. Stay dangerous."
		"Powering down comms before I say something heartfelt."
		"See you next match. Bring better material."
	}
	chat order {
		"Copy that, $other. Morris on the move."
		"Loud and clear. Try to keep up with me."
		"Roger, roger. This'll be fun."
		"You heard the boss. Morris out."
		"Message received, $other. Making you look good."
		"On it. Somebody keep the channel warm."
		"Read you five by five. Moving."
		"Okay, okay, I'm going. No need to shout."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Get behind something solid, $other. Then talk."
		"Break contact and clear your head. That's the useful call."
		"Quit standing in the problem and find cover."
		"Protect yourself first. Heroics make terrible reports."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"Hell of a match, $other. You kept the channel busy."
		"Good fight. Even the scoreboard made sense."
		"That's one worth talking about after the bruises fade."
		"Solid work, everyone. Yes, I can be sincere."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"A challenge, $other? Now this gets interesting."
		"Bring it. I've got commentary ready."
		"Fine by me. Try to make the story flattering."
		"Challenge accepted. Keep up with the play-by-play."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"Morris here. Channel sounds better already."
		"Hey, $other. Glad somebody useful checked in."
		"Loud and clear. What's happening?"
		"Good, another voice. Keep it interesting."
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"Yeah, yeah. You owe me a good story."
		"Any time, $other. Don't make it sentimental."
		"You're welcome. That's the official version."
		"No problem. I was already doing everything else."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"Damn right. Nice of you to notice."
		"Thanks, $other. Your judgment's improving."
		"I'll accept that before you reconsider."
		"Good call. I was excellent there."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"We're fine. Just don't make me file it."
		"Apology accepted, $other. Mockery remains available."
		"Forget it. I've made louder mistakes."
		"No harm done. Try not to make it funny twice."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Morris out of your channel. Enjoy the quiet."
		"Take care, $other. Try not to get boring."
		"Good games. I'm saving the rest of my commentary."
		"See you around. Bring better material next time."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Morris"

		"Morris here. Who needs the expert opinion?"
		"I heard my name, $other."
		"Go ahead. The channel's yours for five seconds."
		"You called? Make it interesting."
	}
}
