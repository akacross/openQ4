// tetzlaff.chat
//
// Dialogue for Tetzlaff. Traits and models live in ../characters/tetzlaff.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Tetzlaff" {
	chat entergame {
		"Tetzlaff. The marksmanship lesson starts now."
		"You've heard the range stories. Most of them are true."
		"Make room. I need a clean sight line."
		"I hope someone here appreciates precision."
		"Tetzlaff reporting. Keep the long angles clear."
		"I have arrived. Try not to cross my sight picture unexpectedly."
		"The range champion is ready. The arena may proceed."
		"Settle in. Precision takes a moment to appreciate."
	}
	chat levelstart {
		"$map rewards a disciplined eye. Convenient."
		"Long lanes, clean angles. This should suit me."
		"I set a range record on a layout like this."
		"$map offers several respectable firing positions. I have already ranked them."
		"Initial sight check complete. The rest is execution."
		"Good visibility. Any miss from here will require an unusual explanation."
		"The angles are acceptable. My opponents may be less cooperative."
		"New round. I will establish the proper standard."
	}
	chat kill {
		"Exactly the angle I intended, $other."
		"Clean hit. Notice the trigger timing."
		"The $weapon is adequate in trained hands."
		"That correction was perfect. You can stop moving now."
		"You stepped straight into my sight picture, $other."
		"A difficult shot made routine, $other."
		"The $weapon only needed the correct sight picture."
		"You crossed on schedule, $other. Very considerate."
	}
	chat killGauntlet {
		"The rail would have been excessive, $other."
		"Even a marksman handles close work."
		"I came over personally. Feel honored."
		"Range was unavailable, so technique adapted."
		"$other, that was close-quarters precision."
		"The shortest sight line can still be mastered."
		"A marksman should be complete. Consider that proof."
		"No need for distance when the timing is exact."
	}
	chat killStreak {
		"There it is. The old range form is back."
		"Three clean hits. Try to remember the lesson."
		"Take notes. Consistency is the difficult part."
		"The grouping is tightening exactly as predicted."
		"Three in sequence. Consistency has returned."
		"This is what happens when calibration finally holds."
		"The arena is beginning to resemble a proper range."
		"Excellent rhythm. Mine, naturally."
	}
	chat revenge {
		"Your first shot spoiled my calibration, $other. Fixed now."
		"There. One warm-up pass was enough."
		"I needed one pass to read your movement."
		"I completed the adjustment, $other. Observe the difference."
		"Your earlier shot provided useful calibration data."
		"$other, the sight picture is corrected now."
		"A temporary deviation, followed by the expected result."
		"I needed one sample. You supplied it."
	}
	chat death {
		"Sight drift. I'll correct it."
		"$other caught me between adjustments."
		"The angle was sound; the timing was not."
		"Good shot. Mine would have been cleaner."
		"The $weapon disturbed an otherwise excellent setup."
		"A strong shot, $other. The angle favored you."
		"I corrected for movement and neglected your timing."
		"That result reflects positioning, not marksmanship."
	}
	chat deathAccident {
		"Faulty depth mark. The map needs recalibration."
		"That edge is not where the sight line says it is."
		"Deliberate route test. Result noted."
		"The range diagram omitted a critical vertical detail."
		"Foot placement is outside the marksmanship evaluation."
		"An environmental irregularity. My aim remains unaffected."
		"I was testing the boundary, not the target."
		"The sight line was excellent. The landing was not."
	}
	chat itemDenied {
		"$other disrupted the timing on that $item."
		"I was measuring the respawn window, not contesting it."
		"Take the $item. I prefer winning without assistance."
		"$other reached the $item during my sight adjustment."
		"The $item was tactically optional. I have now confirmed it."
		"A pickup race is not a shooting discipline, $other."
		"Keep the $item. Additional assistance may improve the competition."
		"My timing was correct for the previous spawn cycle."
	}
	chat leadTaken {
		"First place confirms the range data."
		"Now the board matches the skill level."
		"Lead secured. The score is catching up with my technique."
		"The ranking has corrected itself."
		"First place is the natural result of sound technique."
		"Now everyone can see what the range data already showed."
		"Lead confirmed. The warm-up period is officially complete."
		"The score has achieved technical accuracy."
	}
	chat leadLost {
		"$other is borrowing the lead while I warm up."
		"They count rushed shots too. An obvious flaw."
		"Brief setback. My grouping will recover."
		"$other is ahead. The cleaner shots are still mine."
		"The board rewards haste. I prefer proper form."
		"A rough grouping. The next one will tighten."
		"The lead changed during a calibration interval."
		"No concern. I know which shots to correct."
	}
	chat matchWin {
		"Expected result. The grouping tightened nicely."
		"That's what disciplined shooting looks like."
		"Good match. You were useful moving targets."
		"The final score validates the method."
		"A satisfying demonstration of repeatable technique."
		"The arena produced a fair result after all."
		"Victory is simply accuracy accumulated over time."
		"The record will show what I explained at the start."
	}
	chat matchLose {
		"Interesting result. The sight picture never settled."
		"Better timing won this round. My technique is still superior."
		"Call it a warm-up. The rematch is the real score."
		"The score favored activity over precision."
		"One poor scorecard does not erase a range record."
		"My grouping was excellent; the point distribution was unfortunate."
		"The conditions rewarded improvisation more than proper form."
		"Record the result if you must. The technique remains sound."
	}
	chat farewell {
		"Tetzlaff out. Review the shots while they're fresh."
		"I'm leaving before bad habits become contagious."
		"Good practice. You'll appreciate it later."
		"That concludes the lesson. Further practice is your responsibility."
		"Tetzlaff departing. Try to preserve the better angles."
		"The range is yours. Use it responsibly."
		"I am finished here. The demonstration was adequate."
		"Practice what you observed. Selectively."
	}
	chat order {
		"Understood, $other. I'll find a firing line."
		"Copy. Repositioning for clean sights."
		"Acknowledged. Precision follows."
		"On it. I'll measure the angles there."
		"Fine, $other. I'll make every shot count."
		"Moving. Somebody spot for me."
		"Received. Expect accuracy, not noise."
		"Relocating. The range will be mine."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Find stable cover, $other. Then reassess your position."
		"Stop rushing the lane. Set your feet first."
		"A shorter exposure will improve your odds immediately."
		"Reset your position. Make the next exposure deliberate."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"A respectable match, $other. The form was nearly proper."
		"Good contest. The final score captured most of the technique."
		"Your movement made the demonstration worthwhile."
		"That was useful practice for everyone involved."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"Accepted. Observe carefully, $other."
		"You want a demonstration? Hold still long enough."
		"Very well. Choose the distance."
		"Challenge noted. My calibration is already complete."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"Tetzlaff here. Mind the sightline."
		"Hello, $other. You've reached the range authority."
		"Good, an audience with functioning comms."
		"Welcome. Watch closely and ask sensible questions."
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"You're welcome. The technique is repeatable."
		"Your thanks confirm the lesson, $other."
		"No trouble. Good instruction should look effortless."
		"Think of it as a practical lesson."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"Naturally, though I appreciate the confirmation."
		"Thank you, $other. You recognized proper form."
		"The result was difficult to overlook."
		"Your eye for technique is improving."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"Accepted. Recalibrate and continue."
		"The deviation is noted, $other."
		"Mistakes happen when form slips."
		"No lasting harm. Correct the next attempt."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Tetzlaff out. Review what you observed."
		"Goodbye, $other. Keep your grouping tight."
		"The lesson concludes here."
		"Until next time. Practice with purpose."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Tetzlaff"

		"Tetzlaff here. Ask your question."
		"You called the marksman, $other."
		"I hear you. Be specific."
		"Yes? The range authority is listening."
	}
}
