// cortez.chat
//
// Dialogue for Cortez. Traits and models live in ../characters/cortez.bot.
// Format and event reference: docs/dev/mp-bots.md.

characterChat "Cortez" {
	chat entergame {
		"Cortez reporting. Good hunting, everyone."
		"I am ready. Let us see who finds the first opening."
		"Let us make this a clean match."
		"I have been looking forward to this."
		"Cortez is ready. May the better shot win."
		"Good to see you, everyone. I hope your aim is honest."
		"Weapon checked. One clear angle will be enough."
		"I will take the long view. Please, begin."
	}
	chat levelstart {
		"$map. There are some very useful angles here."
		"Take your positions. I will find mine."
		"Good sightlines. This should be interesting."
		"$map rewards patience. I approve."
		"There is a clean line through the center."
		"Mind the high ground. Someone will use it."
		"I see three approaches and only two safe ones."
		"Choose your cover carefully. I intend to test it."
	}
	chat kill {
		"A clean shot, $other."
		"You left me an angle."
		"Well fought. The opening was enough."
		"$weapon was the right choice."
		"One chance was all I needed."
		"Your movement was good, $other. The angle was better."
		"One round. No correction required."
		"You nearly cleared the sightline."
	}
	chat killGauntlet {
		"Closer than I prefer, but effective."
		"That became rather personal, $other."
		"You allowed me too close, $other."
		"This was not the angle I had in mind."
		"A little inelegant, but we are finished."
		"At this distance, patience becomes difficult."
		"$other, next time we should keep this professional."
		"No ammunition spent. An unusual economy."
	}
	chat killStreak {
		"The angles keep presenting themselves."
		"Steady now. There is plenty of match left."
		"Good. I have found my rhythm."
		"Three openings, three answers."
		"I will not mistake a good sequence for a finished match."
		"The sightlines remain unusually generous."
		"My ammunition count remains satisfactory."
		"There is a certain comfort in consistent work."
	}
	chat revenge {
		"A fair answer to your last shot."
		"We are even now, $other."
		"You had the advantage. Had."
		"Your lesson was useful, $other. Gracias."
		"I remembered precisely where you stood."
		"A debt settled without interest."
		"You showed me the weakness in my position."
		"The second angle belonged to me."
	}
	chat death {
		"Well placed, $other."
		"I exposed myself for too long."
		"That $weapon found its mark."
		"Very good. I will adjust."
		"A precise answer. I respect it."
		"I should have changed positions sooner."
		"$other, you read that exchange correctly."
		"The next sightline will be less forgiving."
	}
	chat deathAccident {
		"A careless mistake. Mine entirely."
		"I misjudged the distance."
		"That was not my finest moment."
		"I trusted the footing without checking it."
		"No opponent to credit for that one."
		"A poor angle can punish the shooter as well."
		"I moved before I finished thinking."
		"Please disregard that demonstration."
	}
	chat itemDenied {
		"You timed that $item well, $other."
		"I arrived a moment too late."
		"Keep it. I will manage."
		"The $item was worth the risk. Nicely judged."
		"$other, your route was more efficient."
		"I will revise my timing."
		"The $item is gone. The firing line remains."
		"You may keep the $item. I prefer the angle."
	}
	chat leadTaken {
		"The lead is mine. Let us continue."
		"Precision has its rewards."
		"A good beginning, nothing more."
		"First place is an angle I know how to hold."
		"A narrow lead. I will treat it carefully."
		"The board agrees with my aim."
		"I have the advantage. Complacency would waste it."
		"$other, thank you for making this difficult."
	}
	chat leadLost {
		"The lead is yours for now, $other."
		"Well taken. I will earn it back."
		"Enjoy first place while it lasts."
		"A fine challenge. I accept it."
		"$other found the better line."
		"The score changed. My aim did not."
		"I was too comfortable. That is corrected."
		"One careful shot can change this again."
	}
	chat matchWin {
		"A fine match. Gracias."
		"Good shooting, everyone."
		"That went almost exactly as planned."
		"Thank you. That was worth the ammunition."
		"The last shot was the only one that mattered."
		"A disciplined match and a satisfying result."
		"The angles favored me in this match."
		"You made every clean shot necessary."
	}
	chat matchLose {
		"A deserved victory. Well played."
		"I was outshot this time. It happens."
		"A good match. I would welcome another."
		"My aim was sound. My choices were not."
		"There was always one angle I failed to cover."
		"I will remember how this match turned."
		"You gave me very little to shoot at. Well done."
		"Defeat is precise feedback. I will use it."
	}
	chat farewell {
		"Good games. Cortez signing off."
		"Until next time, my friends."
		"Thank you for the match. I am heading out."
		"I have spent enough ammunition for now."
		"Farewell. Keep your sights steady."
		"A pleasure, everyone. Choose better cover next time."
		"Cortez out. Leave me one good angle next time."
		"That is enough shooting for now. Take care."
	}
	chat order {
		"Understood, $other. I will see to it."
		"Very well. I am moving."
		"Of course. Consider it handled."
		"As you wish, $other."
		"A sensible plan. I am on my way."
		"Claro. I will hold my end."
		"Received. I will find the right angle there."
		"Then that is where I am needed."
	}
	reply help {
		priority 40
		source any
		addressed either

		trigger "help me"
		trigger "need help"
		trigger "need a medic"
		trigger "need health"
		trigger "need armor"
		trigger "cover me"
		trigger "need backup"

		"Choose cover before speed, $other."
		"Breathe, find one safe angle, and use it."
		"Do not force the opening. Another will appear."
		"Protect your retreat before you take the shot."
	}
	reply goodGame {
		priority 30
		source any
		addressed either

		trigger "gg"
		trigger "ggwp"
		trigger "good game"
		trigger "great game"
		trigger "good match"
		trigger "great match"
		trigger "well played"
		trigger "good games"

		"A fine match, $other. Gracias."
		"Your timing made that contest worthwhile."
		"Well played. I would welcome another."
		"That was honest competition and a fair result."
	}
	reply challenge {
		priority 25
		source any
		addressed either

		trigger "bring it"
		trigger "come get me"
		trigger "fight me"
		trigger "try me"
		trigger "come on then"
		trigger "you suck"
		trigger "noob"
		trigger "ez"

		"Very well, $other. I accept."
		"Find your best position. I will find mine."
		"A direct challenge deserves a precise answer."
		"Come, then. Let us make the first shot matter."
	}
	reply greeting {
		priority 20
		source any
		addressed either

		trigger "hi"
		trigger "hello"
		trigger "hey"
		trigger "greetings"
		trigger "good morning"
		trigger "good evening"

		"It is good to hear you, $other."
		"Welcome. I hope your aim is steady."
		"Cortez here. It is a pleasure."
		"Hello, my friend. Let us keep this interesting."
	}
	reply thanks {
		priority 20
		source any
		addressed either

		trigger "thanks"
		trigger "thank you"
		trigger "thx"
		trigger "ty"

		"You are welcome, $other."
		"Of course. Courtesy costs no ammunition."
		"Gracias. I am glad it was useful."
		"Think nothing of it. We continue."
	}
	reply praise {
		priority 20
		source any
		addressed either

		trigger "nice shot"
		trigger "good shot"
		trigger "great shot"
		trigger "nice kill"
		trigger "good kill"
		trigger "nice one"
		trigger "well done"
		trigger "good work"

		"Thank you. Your judgment is generous."
		"I appreciate that from someone with a careful eye."
		"Gracias, $other. You noticed the difficult part."
		"A precise compliment. I will try to deserve it again."
	}
	reply apology {
		priority 20
		source any
		addressed either

		trigger "sorry"
		trigger "my bad"
		trigger "apologies"
		trigger "oops"
		trigger "whoops"

		"No offense remains between us."
		"Accepted, $other. Let us continue cleanly."
		"Mistakes happen. What follows matters more."
		"You have my respect for saying so."
	}
	reply farewell {
		priority 20
		source any
		addressed either

		trigger "bye"
		trigger "goodbye"
		trigger "good night"
		trigger "gtg"
		trigger "gotta go"
		trigger "see ya"
		trigger "see you later"

		"Farewell, $other. Keep your sights steady."
		"Until next time. I enjoyed the contest."
		"Take care, my friend."
		"Goodbye. Leave one good angle for me."
	}
	reply direct {
		priority 0
		source any
		addressed required

		trigger "Cortez"

		"Cortez here. What is it, $other?"
		"I am listening."
		"You have my attention. Please continue."
		"Yes, my friend? Speak."
	}
}
