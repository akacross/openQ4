// roamer.style
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Plays the map rather than the player.  A roamer runs the item rotation,
// takes the fights that happen to be on its route, and leaves the ones that
// are not.  It sits closest to the bare skill curve of any archetype on
// purpose: it is the readable middle everything else is measured against, and
// it is what a server operator gets when they do not care which style shows up.

style "roamer" {
	description	"runs the item rotation and fights what gets in the way"

	set	combatRange		620
	set	aggression		0.50
	set	patience		0.45
	add	initiative		0.05
	set	targetStickiness	0.35
	set	opportunism		0.95
	set	vengefulness		0.10
	add	suppressionMsec	100
	set	strafeRhythmMsec	450
	set	strafeRhythmVarianceMsec	700
	set	weaponSwitchMsec	400

	// The whole identity is here.  Everything else stays near the baseline so
	// that a roamer reads as "a normal player" at every skill level.
	scale	itemFocus		1.40

	// Breaks off to make the next pickup rather than following a wounded
	// enemy into somebody else's fight.
	scale	pursuit			0.85
	scale	reacquireMsec		0.90
	add	rangeDiscipline		0.05

	weapon	"weapon_rocketlauncher"		1.25
	weapon	"weapon_lightninggun"		1.15
	weapon	"weapon_railgun"		1.05
	weapon	"weapon_hyperblaster"		1.05
	weapon	"weapon_nailgun"		1.00
	weapon	"weapon_machinegun"		1.00
	weapon	"weapon_shotgun"		0.95
	weapon	"weapon_grenadelauncher"	0.85
	weapon	"weapon_blaster"		0.60
	weapon	"weapon_gauntlet"		0.50

	// A skill 1 bot that only chases items never learns it is in a deathmatch.
	// Pull the item weighting back down so it still turns and fights.
	skill 1 {
		scale	itemFocus		0.85
	}

	// At the top, running the rotation is the whole strategy, and it is
	// willing to wait out a respawn to keep it.
	skill 5 {
		add	itemFocus		0.15
		add	patience		0.05
	}
}
