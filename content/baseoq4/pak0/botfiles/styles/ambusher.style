// ambusher.style
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Chooses a place instead of a target.  An ambusher parks near a choke or a
// major item, keeps its view on the doorway rather than sweeping the room, and
// takes the shot it has already lined up.  Because it is pre-aimed it appears
// to react faster than its skill level should allow - the reaction discount is
// paid for by giving up mobility, pursuit and initiative entirely.

style "ambusher" {
	description	"holds a choke point and shoots what walks into it"

	set	combatRange		700
	set	aggression		0.30
	set	patience		0.95
	add	initiative		-0.04
	set	targetStickiness	0.78
	set	opportunism		0.85
	set	vengefulness		0.20
	add	suppressionMsec	450
	set	strafeRhythmMsec	900
	set	strafeRhythmVarianceMsec	450
	set	weaponSwitchMsec	700
	set	aimHeight		0.04

	// Pre-aimed at the doorway.  The peripheral penalty is what a bot pays for
	// noticing something off the centre of its view, and an ambusher is
	// already looking at the only place anyone can come from.
	scale	peripheralPenaltyMsec	0.60
	scale	reactionMsec		0.85
	scale	aimSettleMsec		0.85

	// It does not move and it does not follow.  Both of those are the cost of
	// the reaction discount above; without them this is just a better bot.
	scale	strafeChance		0.55
	scale	jumpChance		0.60
	scale	pursuit			0.55
	add	rangeDiscipline		0.10

	// Sits on the item it is guarding, which is usually why the spot is worth
	// guarding in the first place.
	add	itemFocus		0.20

	weapon	"weapon_rocketlauncher"		1.50
	weapon	"weapon_grenadelauncher"	1.40
	weapon	"weapon_railgun"		1.25
	weapon	"weapon_shotgun"		1.20
	weapon	"weapon_nailgun"		1.10
	weapon	"weapon_lightninggun"		1.00
	weapon	"weapon_hyperblaster"		0.95
	weapon	"weapon_machinegun"		0.90
	weapon	"weapon_gauntlet"		0.60
	weapon	"weapon_blaster"		0.50

	// A skill 1 ambusher standing perfectly still in a corner it cannot shoot
	// out of is not an opponent, it is scenery.  Make the bottom of the band
	// leave its spot occasionally.
	skill 1 {
		scale	patience		0.80
		add	aggression		0.10
		scale	strafeChance		1.30
	}
	skill 2 {
		scale	patience		0.90
	}

	// At the top the shot is already taken by the time you are through the
	// door.
	skill 5 {
		scale	reactionMsec		0.90
		scale	fireConeDeg		0.90
	}
}
