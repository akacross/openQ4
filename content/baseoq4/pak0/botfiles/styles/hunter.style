// hunter.style
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Picks one player and follows them out of the room.  A hunter holds a target
// through cover, keeps chasing long after a roamer would have shrugged and
// gone for armour, and will walk past a better opportunity to finish the one
// it started.  That fixation is a behaviour, not a competence: it is why a
// skilled hunter is terrifying and an unskilled one spends the match running
// down a corridor after somebody who left.

style "hunter" {
	description	"fixates on one target and follows it out of the room"

	set	combatRange		480
	set	aggression		0.72
	set	patience		0.30
	add	initiative		0.18
	set	targetStickiness	0.92
	set	opportunism		0.75
	set	vengefulness		0.60
	add	suppressionMsec	350
	set	strafeRhythmMsec	550
	set	strafeRhythmVarianceMsec	500
	set	weaponSwitchMsec	450

	// The chase.  pursuit scales how long a lost enemy stays worth chasing,
	// and the longer reacquire window means breaking line of sight for a
	// second does not buy a fresh reaction time.
	scale	pursuit			1.60
	scale	reacquireMsec		1.40
	scale	reacquireFraction	0.90

	// Looks further than it needs to, because the target it wants may not be
	// the one in the room.
	scale	sightRange		1.10

	// Deliberately worse at switching targets.  A hunter that correctly
	// retargets the weakest enemy every frame is not a hunter, it is a roamer
	// with better numbers.
	scale	targetSelection		0.85
	scale	itemFocus		0.65

	weapon	"weapon_rocketlauncher"		1.30
	weapon	"weapon_railgun"		1.20
	weapon	"weapon_lightninggun"		1.15
	weapon	"weapon_nailgun"		1.10
	weapon	"weapon_machinegun"		1.00
	weapon	"weapon_hyperblaster"		1.00
	weapon	"weapon_shotgun"		0.90
	weapon	"weapon_grenadelauncher"	0.70
	weapon	"weapon_gauntlet"		0.60
	weapon	"weapon_blaster"		0.50

	// At the bottom of the band the chase is just pathing into walls, so
	// shorten it - a skill 1 hunter should lose the target and find another.
	skill 1 {
		scale	pursuit			0.80
		scale	sightRange		0.95
	}
	skill 2 {
		scale	pursuit			0.90
	}

	// At the top it simply does not forget you.
	skill 5 {
		scale	reacquireMsec		1.15
		scale	reacquireFraction	0.92
	}
}
