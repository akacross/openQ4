// rusher.style
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Closes the distance and refuses to give it back.  A rusher treats every
// sighting as an invitation, fights at brawling range with whatever sprays
// fastest, fires early rather than accurately, and keeps coming while it still
// has health to spend.  It is the natural counter to the sniper and the
// ambusher on a tight map, and it is the first archetype to die on an open one.

style "rusher" {
	description	"closes to brawling range and keeps the trigger down"

	set	combatRange		220
	set	aggression		0.88
	set	patience		0.15
	add	initiative		0.30
	set	targetStickiness	0.72
	set	opportunism		0.55
	set	vengefulness		0.35
	add	suppressionMsec	300
	set	strafeRhythmMsec	280
	set	strafeRhythmVarianceMsec	450
	set	weaponSwitchMsec	300
	set	aimHeight		-0.04

	// Being close is the plan; being exactly 220 units away is not, so the
	// range discipline is deliberately loose.  It wants "inside", not "here".
	scale	rangeDiscipline		0.70

	// Movement is forward, not sideways.  Strafing is traded for jumping,
	// which is what actually beats a rocket at this distance.
	scale	strafeChance		0.85
	scale	jumpChance		1.35
	scale	dodgeReactMsec		0.85

	// Fires early and holds it down.  This is a real accuracy loss and it is
	// meant to be - the pressure is the weapon, not the hit rate.
	scale	fireConeDeg		1.30
	scale	aimSettleMsec		0.65
	scale	burstMaxMsec		1.25
	scale	burstPauseMsec		0.80

	// Fights on when hurt and chases what runs.  Items are somebody else's
	// problem until there is nobody left to shoot at.
	scale	retreatHealth		0.65
	scale	pursuit			1.30
	scale	itemFocus		0.80
	scale	reacquireMsec		0.85

	weapon	"weapon_shotgun"		1.90
	weapon	"weapon_gauntlet"		1.60
	weapon	"weapon_hyperblaster"		1.50
	weapon	"weapon_lightninggun"		1.35
	weapon	"weapon_nailgun"		1.30
	weapon	"weapon_rocketlauncher"		1.15
	weapon	"weapon_machinegun"		0.90
	weapon	"weapon_grenadelauncher"	0.70
	weapon	"weapon_blaster"		0.50
	weapon	"weapon_railgun"		0.35

	// A skill 1 rusher that sprints into a shotgun every thirty seconds is not
	// a difficulty setting, it is a free frag.  Give the bottom of the band
	// some distance and some self-preservation back.
	skill 1 {
		scale	combatRange		1.60
		add	retreatHealth		0.08
		scale	aggression		0.85
	}
	skill 2 {
		scale	combatRange		1.30
		add	retreatHealth		0.04
	}

	// At the top the aggression is a read, not a reflex: it commits because it
	// expects to win the trade, and it dodges on the way in.
	skill 5 {
		scale	dodgeReactMsec		0.85
		add	aggression		0.05
	}
}
