// skirmisher.style
//
// openQ4 bot personality format, version 1.
// Format and trait reference: docs/dev/archive/2026-10-18/plans/2026-07-29-bot-characters.md
//
// Trades in short bursts and leaves before the trade finishes.  A skirmisher
// fights at the outer edge of mid range, never stops moving, taps rather than
// holds, and breaks off at a health level everything else would still fight at.
// Against a rusher it is infuriating; against a sniper it is food.

style "skirmisher" {
	description	"hits, moves, and breaks off early"

	set	combatRange		850
	set	aggression		0.45
	set	patience		0.35
	add	initiative		0.12
	set	targetStickiness	0.30
	set	opportunism		1.00
	set	vengefulness		0.15
	add	suppressionMsec	100
	set	strafeRhythmMsec	220
	set	strafeRhythmVarianceMsec	400
	set	weaponSwitchMsec	280

	// Never in the same place twice.
	scale	strafeChance		1.30
	scale	jumpChance		1.45
	scale	dodgeReactMsec		0.80
	add	rangeDiscipline		0.08

	// Short trades: it shoots, it reassesses, it moves.  The shorter burst is
	// a real damage loss, paid back by never being where the return fire is.
	scale	burstMaxMsec		0.75
	scale	burstPauseMsec		0.85

	// Leaves early and comes back healthy.  Chasing is somebody else's job.
	add	retreatHealth		0.12
	scale	pursuit			0.75
	scale	itemFocus		1.15

	weapon	"weapon_lightninggun"		1.35
	weapon	"weapon_nailgun"		1.30
	weapon	"weapon_rocketlauncher"		1.25
	weapon	"weapon_hyperblaster"		1.20
	weapon	"weapon_railgun"		1.05
	weapon	"weapon_machinegun"		1.00
	weapon	"weapon_shotgun"		0.80
	weapon	"weapon_grenadelauncher"	0.75
	weapon	"weapon_blaster"		0.55
	weapon	"weapon_gauntlet"		0.45

	// A skill 1 bot jumping this much mostly finds the nearest pit, and one
	// that breaks off this early never finishes a fight it started.
	skill 1 {
		scale	jumpChance		0.75
		scale	strafeChance		0.85
		scale	retreatHealth		0.85
	}
	skill 2 {
		scale	jumpChance		0.85
	}

	// At the top the movement is the defence, and the bursts get shorter still.
	skill 5 {
		scale	burstMaxMsec		0.90
		add	jumpChance		0.05
	}
}
